-- Tabler outline icons, pinned upstream sources and license are bundled below.
-- PNGs are embedded and cached locally; sidebar icons make no network requests.
do
    local assets={
        COMBAT={name="crosshair",hash="3bdd96c78324",bytes=1308,png=""},
        CAVALRY={name="horse",hash="c854ea73b970",bytes=2273,png=""},
        PLAYER={name="user",hash="cc9f820f7c2d",bytes=1803,png=""},
        SETTINGS={name="adjustments-horizontal",hash="dbb93f33280b",bytes=1183,png=""},
    }
    local lookup={}
    local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i=1,#alphabet do lookup[alphabet:byte(i)]=i-1 end
    local function decode(encoded)
        local result={}
        for i=1,#encoded,4 do
            local a,b,c,d=encoded:byte(i,i+3)
            local value=lookup[a]*262144+lookup[b]*4096+(lookup[c] or 0)*64+(lookup[d] or 0)
            result[#result+1]=string.char(math.floor(value/65536))
            if c~=61 then result[#result+1]=string.char(math.floor(value/256)%256) end
            if d~=61 then result[#result+1]=string.char(value%256) end
        end
        return table.concat(result)
    end
    local function valid(body,expected)
        return type(body)=="string" and #body==expected and body:sub(1,8)=="\137PNG\13\10\26\10"
    end
    X.ui.iconsLoaded=0
    function X.ui.drawIcon(parent,kind)
        local asset=assets[kind]
        local icon=make("ImageLabel",{Name="NavIcon",Position=UDim2.fromOffset(10,6),Size=UDim2.fromOffset(24,24),
            BackgroundTransparency=1,BorderSizePixel=0,ImageColor3=Color3.fromRGB(132,104,114),
            ScaleType=Enum.ScaleType.Fit,Active=false,ZIndex=4},parent)
        if not asset then return icon end
        icon:SetAttribute("IconLibrary","Tabler");icon:SetAttribute("IconName",asset.name)
        task.spawn(function()
            if not alive or not icon.Parent then return end
            local ok,err=pcall(function()
                local register=getcustomasset or getsynasset
                assert(folderReady and type(isfile)=="function" and type(readfile)=="function"
                    and type(writefile)=="function" and type(register)=="function","Local icon assets unavailable")
                local filename=VG_ASSET_FOLDER.."/tabler-"..asset.name.."-"..asset.hash..".png"
                local cached=isfile(filename) and readfile(filename)
                if not valid(cached,asset.bytes) then
                    local png=decode(asset.png)
                    assert(valid(png,asset.bytes),"Embedded icon is invalid")
                    writefile(filename,png)
                end
                local image=register(filename)
                if not alive or not icon.Parent then return end
                icon.Image=image
                game:GetService("ContentProvider"):PreloadAsync({icon})
                local deadline=os.clock()+8
                while alive and icon.Parent and not icon.IsLoaded and os.clock()<deadline do task.wait(.1) end
                if not alive or not icon.Parent then return end
                assert(icon.IsLoaded,"Cached sidebar icon did not render")
                X.ui.iconsLoaded+=1;gui:SetAttribute("SidebarIconsReady",X.ui.iconsLoaded)
                icon:SetAttribute("IconStatus","Loaded")
            end)
            if not ok and alive and icon.Parent then
                icon:SetAttribute("IconStatus",tostring(err));gui:SetAttribute("SidebarIconError",tostring(err))
                if not X.ui.iconWarning then X.ui.iconWarning=true;warn("VG sidebar icons: "..tostring(err)) end
            end
        end)
        return icon
    end
end

