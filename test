                        local peer=peers[state.random:NextInteger(1,#peers)]
                        location.order=peer.LayoutOrder;location.alpha=peer.BackgroundTransparency
                    else location.target=nil end
                end
                local target=location.target
                if target and origin and origin.Parent and origin:IsDescendantOf(leaderboard) then
                    maskProperty(row,"Parent",target)
                    maskProperty(row,"LayoutOrder",location.order)
                    maskProperty(row,"BackgroundTransparency",location.alpha)
                else
                    -- Restore the row first when no destination remains, then
                    -- measure both former lines with their real child counts.
                    restoreRowPlacement(row)
                    location.target=nil
                end
            else state.locations[row]=nil end
        end
        syncStreamerLineSpace()
    end

    function X.restoreStreamer()
        if state.active then syncStreamerLineSpace() end
        state.active=false
        for object,entries in pairs(state.masked) do
            for property,entry in pairs(entries) do restoreEntry(object,property,entry) end
            state.masked[object]=nil
        end
        for button,entry in pairs(state.buttons) do
            pcall(button.SetActive,button,entry.before)
            state.buttons[button]=nil
        end
        for row in pairs(state.locations) do state.locations[row]=nil end
        gui:SetAttribute("StreamerMode",false)
    end
    function X.refreshStreamerMask()
        if not C.StreamerMode then
            if state.active then X.restoreStreamer() end
            return
        end
        state.active=true
        for _,entries in pairs(state.masked) do for _,entry in pairs(entries) do entry.used=false end end
        for _,entry in pairs(state.buttons) do entry.used=false end
        local managed={}
        for member in pairs(state.members) do
            local row=nativeLabel(member)
            local button=rawget(member,"button")
            if row and row.Parent and row:IsDescendantOf(pg) and type(button)=="table"
                and type(button.SetActive)=="function" and type(button.active)=="boolean" then
                local entry=state.buttons[button]
                if not entry then entry={before=button.active};state.buttons[button]=entry end
                entry.used=true
                -- Release a prior fallback before adopting native hover/selection colors.
                local released=false
                for _,name in ipairs({"Rank","Player","Kills","Deaths","Assists"}) do
                    local text=row:FindFirstChild(name)
                    local entries=text and state.masked[text]
                    if entries then
                        for _,property in ipairs({"TextColor3","TextStrokeColor3"}) do
                            local mask=entries[property]
                            if mask then restoreEntry(text,property,mask);entries[property]=nil;released=true end
                        end
                        if next(entries)==nil then state.masked[text]=nil end
                    end
                end
                -- Use the game's own selection flag so hover/press colors remain native.
                local ok=true
                if button.active or released then ok=pcall(button.SetActive,button,false) end
                if ok then managed[row]=true end
            end
        end
        local count=0
        for row in pairs(state.rows) do
            if row.Parent and row:IsDescendantOf(pg) then
                count+=1
                if not managed[row] then
                    -- Exact-name fallback for rows whose native object is unavailable.
                    local peer
                    for _,candidate in ipairs(row.Parent:GetChildren()) do
                        if candidate~=row and candidate:IsA("GuiObject") and candidate.Name=="MemberLabel"
                            and not state.rows[candidate] and candidate:FindFirstChild("Player") then peer=candidate;break end
                    end
                    for _,name in ipairs({"Rank","Player","Kills","Deaths","Assists"}) do
                        local text=row:FindFirstChild(name)
                        local normal=peer and peer:FindFirstChild(name)
                        if normal and not normal:IsA("TextLabel") then normal=nil end
                        if text and text:IsA("TextLabel") then
                            maskProperty(text,"TextColor3",normal and normal.TextColor3 or Color3.fromRGB(243,250,255))
                            maskProperty(text,"TextStrokeColor3",normal and normal.TextStrokeColor3 or Color3.fromRGB(59,65,76))
                        end
                    end
                end
            else state.rows[row]=nil end
        end
        for button,entry in pairs(state.buttons) do
            if not entry.used then pcall(button.SetActive,button,entry.before);state.buttons[button]=nil end
        end
        relocateRows()
        local combat=pg:FindFirstChild("CombatGui")
        local character=combat and combat:FindFirstChild("CharacterFrame")
        local stats=character and character:FindFirstChild("StatsFrame")
        local tags=stats and stats:FindFirstChild("TagsFrame")
        maskVisual(tags and tags:FindFirstChild("Player"))
        for _,name in ipairs({"Kills","Deaths","Assists"}) do maskVisual(stats and stats:FindFirstChild(name)) end
        for object,entries in pairs(state.masked) do
            for property,entry in pairs(entries) do
                if not entry.used then restoreEntry(object,property,entry);entries[property]=nil end
            end
            if next(entries)==nil then state.masked[object]=nil end
        end
        gui:SetAttribute("StreamerMode",true);gui:SetAttribute("StreamerLocalRows",count)
    end
    function X.refreshStreamerAdapters()
        if type(getloadedmodules)=="function" then
            for _,module in ipairs(getloadedmodules()) do
                if not module:IsDescendantOf(game:GetService("CorePackages")) then
                    local ok,class=VGRequire(module)
                    if ok and type(class)=="table" and rawget(class,"ClassName")=="MemberLabelClient" and not state.classes[class] then
                        state.classes[class]=true
                        wrapMethod(class,"new",function(original,player,...)
                            local result=table.pack(original(player,...))
                            if localPlayer(player) then X.adoptStreamerMember(result[1]) end
                            return table.unpack(result,1,result.n)
                        end)
                    elseif ok and type(class)=="table" and rawget(class,"ClassName")=="CompanyFrameClient" and not state.classes[class] then
                        state.classes[class]=true
                        wrapMethod(class,"Destroy",function(original,company,...)
                            X.rescueStreamerRows(company.membersFrame)
                            return original(company,...)
                        end)
                    end
                end
            end
        end
        -- Adopt rows created before execution through callbacks bound to P's stats.
        if type(getconnections)=="function" and debug and type(debug.getupvalues)=="function" then
            local ok,connections=pcall(getconnections,P:GetAttributeChangedSignal("Kills"))
            if ok then for _,connection in ipairs(connections) do
                local success,callback=pcall(function()return connection.Function end)
                if success and type(callback)=="function" then
                    local valid,values=pcall(debug.getupvalues,callback)
                    if valid then for _,value in pairs(values) do
                        local class=type(value)=="table" and getmetatable(value)
                        if type(class)=="table" and rawget(class,"ClassName")=="MemberLabelClient" then X.adoptStreamerMember(value) end
                    end end
                end
            end end
        end
        -- Exact native name fallback also handles NameSwaps and verified badges.
        local display=P.Name
        local swaps=game:GetService("ReplicatedStorage"):FindFirstChild("NameSwaps")
        if swaps and swaps:IsA("ModuleScript") then
            local ok,names=VGRequire(swaps)
            if ok and type(names)=="table" and type(names[P.Name])=="string" then display=names[P.Name] end
        end
        for _,object in ipairs(pg:GetDescendants()) do
            if object.Name=="Player" and object:IsA("TextLabel") then
                local row=object.Parent
                if row and row.Name=="MemberLabel" and row.Parent and row.Parent.Name=="MembersFrame"
                    and (object.Text==display or object.Text==display.." "..utf8.char(0xE000)) then state.rows[row]=true end
            end
        end
        state.adaptersDiscovered=true
        X.refreshStreamerMask()
    end
    function X.getOwnLineRank()
        if not state.adaptersDiscovered then X.refreshStreamerAdapters() end
        for row in pairs(state.rows) do
            local host=nativeValue(row,"Parent")
            if host and row:IsDescendantOf(pg) then
                local rows={}
                for index,child in ipairs(host:GetChildren()) do
                    if child:IsA("GuiObject") and child.Name=="MemberLabel" and child:FindFirstChild("Kills") then
                        rows[#rows+1]={row=child,index=index,order=nativeValue(child,"LayoutOrder")}
                    end
                end
                if row.Parent~=host then rows[#rows+1]={row=row,index=#rows+1,order=nativeValue(row,"LayoutOrder")} end
                table.sort(rows,function(a,b)return a.order==b.order and a.index<b.index or a.order<b.order end)
                for position,entry in ipairs(rows) do if entry.row==row then return position,#rows end end
            end
        end
        return nil,0
    end
    function X.setStreamerMode(on)
        C.StreamerMode=on
        if on then X.refreshStreamerAdapters() else X.restoreStreamer() end
    end
    local pending=false
    connect(pg.DescendantAdded,function(object)
        if not C.StreamerMode and not C.LineRankOverlay then return end
        local row=object.Parent
        if row and state.rows[row] or object.Name=="CombatGui" or object.Name=="MemberLabel" or object.Name=="Player" or object.Name=="Kills" or object.Name=="StatsFrame" or object.Name=="TagsFrame" then
            if pending then return end;pending=true
            task.defer(function()pending=false;if alive then X.refreshStreamerMask() end end)
        end
    end)
    local clock=0
    connect(Run.Heartbeat,function(dt)
        clock+=dt;if clock<.15 then return end;clock=0
        if C.StreamerMode then X.refreshStreamerMask() end
    end)
    X.deferStartupTask("leaderboard adapters",X.refreshStreamerAdapters)
    table.insert(X.restores,X.restoreStreamer)
end

-- Player > Kills. Server-confirmed player totals and the native battle clock.
-- Insert after the battle-report hooks and before the menu controls.
do
    X.killPace={clock=nil,clockMax=nil,started=nil,outro=nil,clockSample=nil,clockSampleAt=0,
        observedStart=nil,battleSerial=0,fallbackKills=0,lastKills=nil,lastReport=reportState.current,
        initialClockMax=nil,lastActive=nil,lastClock=nil,manualFallback=false}
    local state=X.killPace
    local storage=game:GetService("ReplicatedStorage")
    local function finite(value)
        return type(value)=="number" and value==value and math.abs(value)<math.huge
    end
    local function valueOf(instance)
        if not instance or not instance.Parent then return nil end
        local ok,value=pcall(function()return instance.Value end)
        if ok then return value end
    end
    local function activeBattle()
        return valueOf(state.started)~=false and valueOf(state.outro)~=true
    end
    function X.resetKillPace(observedStart)
        state.battleSerial+=1;state.observedStart=observedStart and os.clock() or nil
        state.initialClockMax=nil;state.lastClock=nil;state.clockSample=nil;state.manualFallback=false
        state.lastReport=reportState.current
        state.fallbackKills=0
        local kills=P:GetAttribute("Kills")
        state.lastKills=finite(kills) and math.max(0,math.floor(kills)) or nil
        if state.lastReport then
            local prior=state.lastReport.priorKills
            state.fallbackKills=(finite(prior) and math.max(0,math.floor(prior)) or 0)+#state.lastReport.kills
        end
        local clock=valueOf(state.clock)
        if finite(clock) then state.clockSample=clock;state.clockSampleAt=os.clock() end
    end
    function X.startFallbackKillPace()
        local clock=valueOf(state.clock)
        local maximum=valueOf(state.clockMax)
        assert(not (finite(clock) and clock>0 and finite(maximum) and maximum>0),"The live battle clock is already available")
        state.observedStart=os.clock();state.manualFallback=true;state.battleSerial+=1
        if X.refreshKillOverlay then X.refreshKillOverlay() end
    end
    function X.paceConfirmedKill()
        -- Called only by killfeedClient.killed, never target practice or hit markers.
        state.fallbackKills+=1
    end
    function X.computeKillPace(kills,target,elapsed,duration,ended)
        target=finite(target) and math.clamp(math.ceil(target),1,200) or 60
        kills=finite(kills) and math.max(0,math.floor(kills)) or 0
        local result={available=false,kills=kills,target=target,ended=ended==true,
            completed=kills>=target,due=false,status="Waiting for battle timer"}
        if not finite(elapsed) or not finite(duration) or duration<=0 then return result end
        duration=math.max(1,duration);elapsed=math.clamp(elapsed,0,duration)
        result.available=true;result.elapsed=elapsed;result.duration=duration
        result.remaining=math.max(0,duration-elapsed);result.expected=target*elapsed/duration
        -- Center each kill slot so the final kill becomes due before time expires.
        result.nextAt=math.min(duration,(kills+.5)*duration/target)
        result.nextIn=math.max(0,result.nextAt-elapsed)
        if result.ended then result.status="Battle ended"
        elseif result.completed then result.status="Target reached — hold"
        elseif result.remaining<=0 then result.status="Battle time finished"
        else
            result.due=elapsed>=result.nextAt
            if result.due then result.status=result.expected-kills>=2 and "Behind pace — get a kill" or "Time for a kill"
            elseif kills-result.expected>=2 then result.status="Well ahead — wait"
            elseif kills-result.expected>.5 then result.status="Ahead of pace — wait"
            else result.status="On pace — wait" end
        end
        return result
    end
    function X.getKillPace(target)
        local raw=P:GetAttribute("Kills")
        local kills=finite(raw) and math.max(0,math.floor(raw)) or state.fallbackKills
        local active=activeBattle()
        local duration=valueOf(state.clockMax)
        local sample=state.clockSample
        local elapsed,source
        if finite(sample) and sample>=0 and ((finite(duration) and duration>0) or sample>0) then
            duration=finite(duration) and duration>0 and duration or (C.BattleMinutes or 35)*60
            duration=math.max(duration,sample)
            -- Native Clock is replicated seconds remaining; interpolate between updates.
            local remaining=math.max(0,sample-(active and os.clock()-state.clockSampleAt or 0))
            elapsed=math.clamp(duration-remaining,0,duration);source="Battle clock"
        elseif state.observedStart then
            duration=(C.BattleMinutes or 35)*60;elapsed=math.max(0,os.clock()-state.observedStart)
            source=state.manualFallback and "Manual timer" or "Fallback from round start"
        else source="Waiting for a timed battle" end
        local result=X.computeKillPace(kills,target,elapsed,duration,not active)
        result.source=source
        result.battleKey=game.JobId..":"..tostring(state.battleSerial)..":"..tostring(reportState.current and reportState.current.id or "")
        return result
    end
    function X.refreshKillPaceAdapters()
        local gameStatus=storage:FindFirstChild("GameStatus")
        if not gameStatus or state.gameStatus==gameStatus then return end
        state.gameStatus=gameStatus
        state.clock=gameStatus:FindFirstChild("Clock")
        state.clockMax=gameStatus:FindFirstChild("ClockMax")
        state.started=gameStatus:FindFirstChild("Started")
        state.outro=gameStatus:FindFirstChild("OutroActive")
        local function sampleClock()
            local clock=valueOf(state.clock)
            if finite(clock) then
                state.clockSample=clock;state.clockSampleAt=os.clock()
            end
        end
        if state.clock then connect(state.clock.Changed,sampleClock) end
        sampleClock()
        state.lastActive=activeBattle()
        local function activeChanged()
            local active=activeBattle()
            if active and state.lastActive==false then
                X.resetKillPace(true);sampleClock()
            end
            state.lastActive=active
        end
        if state.started then connect(state.started.Changed,activeChanged) end
        if state.outro then connect(state.outro.Changed,activeChanged) end
    end
    X.resetKillPace(false);X.refreshKillPaceAdapters()
    connect(P:GetAttributeChangedSignal("Kills"),function()
        local raw=P:GetAttribute("Kills")
        if not finite(raw) then return end
        local kills=math.max(0,math.floor(raw))
        if state.lastKills and kills<state.lastKills then
            -- Stats resetting with a refreshed native clock identifies a new round.
            state.battleSerial+=1;state.fallbackKills=kills
        end
        state.lastKills=kills
    end)
    connect(storage.ChildAdded,function(child)
        if child.Name=="GameStatus" then X.refreshKillPaceAdapters() end
    end)
end

