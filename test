local respawnClasses={}
local function wrapMethod(t,key,handler)
    local original=t[key]
    if type(original)~="function" then return end
    local replacement=function(...)
        if not alive or not X.startup.ready then return original(...) end
        return handler(original,...)
    end
    VG_ADAPTER_EXPORTS.nativeOriginals[replacement]=original
    t[key]=replacement
    table.insert(adapterRestores,function() if t[key]==replacement then t[key]=original end end)
end
