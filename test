-- Insert before the target-selection functions. Set X.cameraUtility during module discovery.
-- Projectile simulation temporarily replaces CurrentCamera.CFrame with a dummy frame.
do
    X.aimRotationState={}
    X.aimCameraSnapshot={}

    function X.captureAimCamera(camera)
        if not camera then return end
        local state=X.aimCameraSnapshot
        state.camera=camera;state.frame=camera.CFrame;state.viewport=camera.ViewportSize
        state.fov=camera.FieldOfView;state.updatedAt=os.clock()
    end
    local captureBinding="VGAimCameraSnapshot_"..P.UserId
    Run:BindToRenderStep(captureBinding,Enum.RenderPriority.Camera.Value+5,function()
        X.captureAimCamera(workspace.CurrentCamera)
    end)
    table.insert(X.restores,function()Run:UnbindFromRenderStep(captureBinding);table.clear(X.aimCameraSnapshot)end)

    function X.getAimCameraFrame(camera,renderFrame)
        if typeof(renderFrame)=="CFrame" then return renderFrame end
        local state=X.aimCameraSnapshot
        if state.camera==camera and typeof(state.frame)=="CFrame" then return state.frame end
        local utility=X.cameraUtility
        if utility and type(utility.getCameraCFrame)=="function" then
            local ok,frame=pcall(utility.getCameraCFrame)
            if ok and typeof(frame)=="CFrame" then return frame end
        end
        return camera and camera.CFrame
    end

    function X.aimProjectionGeometry(camera)
        if not camera then return nil end
        local state=X.aimCameraSnapshot
        local viewport=state.camera==camera and state.viewport or camera.ViewportSize
        local fov=state.camera==camera and state.fov or camera.FieldOfView
        if not viewport or viewport.X<=0 or viewport.Y<=0 or not fov or fov<=0 or fov>=180 then return nil end
        return viewport,viewport.Y/(2*math.tan(math.rad(fov)*.5))
    end

    function X.projectAimPoint(camera,position,renderFrame)
        local frame=X.getAimCameraFrame(camera,renderFrame)
        local viewport,focal=X.aimProjectionGeometry(camera)
        if not frame or not viewport then return nil,false end
        local localPoint=frame:PointToObjectSpace(position)
        local depth=-localPoint.Z
        if math.abs(depth)<.000001 then return Vector3.new(math.huge,math.huge,depth),false end
        local x=viewport.X*.5+localPoint.X*focal/depth
        local y=viewport.Y*.5-localPoint.Y*focal/depth
        return Vector3.new(x,y,depth),depth>0 and x>=0 and y>=0 and x<=viewport.X and y<=viewport.Y
    end

    function X.aimViewportRay(camera,point,renderFrame)
        local frame=X.getAimCameraFrame(camera,renderFrame)
        local viewport,focal=X.aimProjectionGeometry(camera)
        if not frame or not viewport then return nil end
        local localDirection=Vector3.new((point.X-viewport.X*.5)/focal,-(point.Y-viewport.Y*.5)/focal,-1).Unit
        return Ray.new(frame.Position,frame:VectorToWorldSpace(localDirection))
    end

    function X.clearAimRotation()
        table.clear(X.aimRotationState)
    end

    -- Call before the native utility's Last-priority camera transform.
    function X.rotateAimCamera(camera,renderFrame,origin,worldPoint,response,dt)
        local frame=X.getAimCameraFrame(camera,renderFrame)
        if not frame then X.clearAimRotation();return false end
        local delta=worldPoint-frame.Position
        if delta.Magnitude<.01 then return false end
        local ray=X.aimViewportRay(camera,origin,frame)
        if not ray then return false end
        local from,to=ray.Direction.Unit,delta.Unit
        local axis=from:Cross(to)
        local angle=math.acos(math.clamp(from:Dot(to),-1,1))
        local desired=frame.Rotation
        if angle>.00001 then
            if axis.Magnitude<.00001 then axis=frame.UpVector end
            desired=CFrame.fromAxisAngle(axis.Unit,angle)*desired
        end
        local state=X.aimRotationState
        local now=os.clock()
        local previous=state.camera==camera and state.updatedAt and now-state.updatedAt<.2 and state.rotation or frame.Rotation
        local alpha=1-math.exp(-math.max(1,response)*math.clamp(dt,0,.1))
        local rotation=previous:Lerp(desired,alpha)
        state.camera=camera;state.rotation=rotation;state.updatedAt=now
        if type(X.commitAimRotation)=="function" then X.commitAimRotation(rotation,frame) end
        camera.CFrame=CFrame.new(frame.Position)*rotation
        X.captureAimCamera(camera)
        return true
    end

    function X.nativeAimMouseDelta(frame,rotation,viewSize)
        local from,to=frame.LookVector,rotation.LookVector
        local yawFrom=math.atan2(-from.X,-from.Z)
        local yawTo=math.atan2(-to.X,-to.Z)
        local yaw=math.atan2(math.sin(yawTo-yawFrom),math.cos(yawTo-yawFrom))
        local pitch=math.asin(math.clamp(to.Y,-1,1))-math.asin(math.clamp(from.Y,-1,1))
        return Vector3.new(-yaw*viewSize.X/7.5398223686155035,-pitch*viewSize.Y/5.026548245743669,0)
    end

    -- Discovery follows named native functions. No numeric upvalue slots are assumed.
    function X.installAimInputAdapter()
        local movement=X.movement
        if not movement or type(X.findFunction)~="function" then return false end
        local handler
        for _,name in ipairs({"setCombatCameraLocked","start"}) do
            if type(movement[name])=="function" then
                handler=X.findFunction(movement[name],"combatCameraInputHandler")
                if handler then break end
            end
        end
        if not handler then return false end
        local mouse
        local ok,upvalues=pcall(debug.getupvalues,handler)
        if ok then
            for _,value in pairs(upvalues) do
                if typeof(value)=="Instance" then
                    local valid,width,height=pcall(function()return value.ViewSizeX,value.ViewSizeY end)
                    if valid and type(width)=="number" and type(height)=="number" and width>0 and height>0 then mouse=value;break end
                end
            end
        end
        if not mouse then return false end
        X.nativeAimInputHandler=handler
        X.commitAimRotation=function(rotation,frame)
            if not movement.combatCameraActive or movement.cameraFrozen then return false end
            local melee=X.activeMelee
            if melee and melee.actionBound and (melee.attackCharging or melee.attackCharged) then return false end
            local width,height=mouse.ViewSizeX,mouse.ViewSizeY
            if width<=0 or height<=0 then return false end
            local delta=X.nativeAimMouseDelta(frame,rotation,Vector2.new(width,height))
            if delta.Magnitude<.0001 then return true end
            local success,message=pcall(handler,"CombatMeleeCamera",Enum.UserInputState.Change,{UserInputType=Enum.UserInputType.MouseMovement,Delta=delta})
            if not success then X.aimInputError=tostring(message) end
            return success
        end
        return true
    end
    table.insert(X.restores,X.clearAimRotation)
end


