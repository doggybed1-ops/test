  for _,sound in ipairs(state.tracks) do
   if state.muted[sound]==nil then state.muted[sound]=sound.Volume end
   sound.Volume=0
  end
  gui:SetAttribute("MusicSelected",selected.Name)
  gui:SetAttribute("MusicStatus",state.sound.IsLoaded and "Playing: "..selected.Name or "Loading: "..selected.Name)
 end
