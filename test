    make("UICorner",{CornerRadius=UDim.new(1,0)},fill)
    local knob=make("Frame",{Name="Thumb",AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(9,9),
        BackgroundColor3=Color3.fromRGB(237,221,226),BorderSizePixel=0,ZIndex=6},track)
    make("UICorner",{CornerRadius=UDim.new(1,0)},knob)
    local state={row=row,fill=fill,knob=knob,current=nil,target=0,dragging=false,touch=nil}
    local function stop()
        if state.dragging then host.ScrollingEnabled=state.wasScrolling end
        state.dragging=false;state.touch=nil;state.wasScrolling=nil
        if X.ui.activeSlider==state then X.ui.activeSlider=nil end
    end
    state.stop=stop
    table.insert(X.ui.sliders,state)
    local function update(forceText)
        if forceText or not box:IsFocused() then box.Text=string.format("%.12g",C[key]) end
        local alpha=math.clamp((C[key]-lo)/(hi-lo),0,1)
        state.target=alpha
        if state.current==nil then
            state.current=alpha
            fill.Size=UDim2.new(alpha,0,1,0);knob.Position=UDim2.new(alpha,0,.5,0)
        end
    end
    local function assign(n,fromSlider)
        -- Dragging follows useful increments; exact typed values keep decimals.
        if fromSlider then n=math.floor(n/step+.5)*step end
        if key=="LowRankMax" then setSetting(key,math.floor(math.clamp(n,lo,hi)+.5))
        else C[key]=math.clamp(n,lo,hi) end
        update(true)
    end
    connect(box.FocusLost,function()
        local n=tonumber(box.Text)
        if n and n==n and math.abs(n)<math.huge then
            assign(n,false)
        else
            update(true);X.showMousePopup("Enter a finite number")
        end
    end)
    local function fromX(x)
        local left=track.AbsolutePosition.X
        local alpha=math.clamp((x-left)/math.max(track.AbsoluteSize.X,1),0,1)
        assign(lo+(hi-lo)*alpha,true)
    end
    state.fromX=fromX
    connect(hit.InputBegan,function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            X.ui.cancelSliders()
            state.dragging=true;state.touch=i.UserInputType==Enum.UserInputType.Touch and i or nil
            state.wasScrolling=host.ScrollingEnabled
            X.ui.activeSlider=state
            host.ScrollingEnabled=false;fromX(i.Position.X)
        end
    end)
    table.insert(refreshers,update); update()
end

