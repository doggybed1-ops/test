        if not player then X.cancelAutomationAim();s.status="Kill due; waiting for a clear enemy";return end
        if not X.movement.combatCameraActive then
            s.changingLock=true
            local ok,reason=pcall(X.movement.setCombatCameraLocked,true)
            s.changingLock=false
            if not ok then error(reason,0) end
            s.ownsCamera=X.movement.combatCameraActive==true
        end
        if not X.movement.combatCameraActive or X.movement.cameraFrozen or type(X.rotateAimCamera)~="function" then
            s.status="Waiting for native combat camera";return
        end
        if not action.aiming then s.ownsAim=true;s.action=action;action:BeginAiming() end
