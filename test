do
 X.music={muted={},watched={},tracks={}}
 local ss=game:GetService("SoundService")
 function X.musicRestore()
  local state=X.music
  if state.sound then state.sound:Destroy();state.sound=nil end
  state.restoring=true
  for sound,volume in pairs(state.muted) do pcall(function()sound.Volume=volume end) end
  table.clear(state.muted);state.restoring=false
  gui:SetAttribute("MusicSelected",nil)
 end
 -- Index once in small steps, then update only when tracks change.
 X.music.folders=setmetatable({},{__mode="k"})
 X.music.sounds=setmetatable({},{__mode="k"});X.music.dirty=true
 function X.musicConsider(object)
  local state=X.music
  if object.Name=="MusicTracks" then state.folders[object]=true end
  if not object:IsA("Sound") then return end
  local parent=object.Parent;local folder
  while parent do
   if parent.Name=="MusicTracks" then folder=parent;break end
   parent=parent.Parent
  end
  if not folder then return end
  state.folders[folder]=true
  if state.sounds[object] then return end
  state.sounds[object]=folder;state.dirty=true
  if not state.watched[object] then
   state.watched[object]=true
   connect(object.AncestryChanged,function()
    state.sounds[object]=nil;state.dirty=true;X.musicConsider(object)
   end)
   connect(object:GetPropertyChangedSignal("Volume"),function()
    if alive and C.MusicOverride and state.sound and not state.restoring and object.Volume~=0 then
     state.muted[object]=object.Volume;object.Volume=0
    end
   end)
   for _,key in ipairs({"Name","SoundId"}) do connect(object:GetPropertyChangedSignal(key),function()state.dirty=true end) end
  end
 end
 function X.musicRescan()
  local state=X.music
  state.dirty=true
  state.scanTicket=(state.scanTicket or 0)+1;local ticket=state.scanTicket
  state.scanning=true;gui:SetAttribute("MusicScanRunning",true)
  task.spawn(function()
   local queue={ss,game:GetService("ReplicatedStorage"),workspace};local head,tail=1,3;local slice=os.clock()
   while alive and ticket==state.scanTicket and head<=tail do
    local object=queue[head];queue[head]=nil;head+=1
    if object and object.Parent then
     X.musicConsider(object)
     for _,child in ipairs(object:GetChildren()) do tail+=1;queue[tail]=child end
    end
    if head%64==0 and os.clock()-slice>=.002 then task.wait();slice=os.clock() end
   end
   if alive and ticket==state.scanTicket then
    state.scanning=false;state.dirty=true;gui:SetAttribute("MusicScanRunning",false)
   end
  end)
 end
 for _,root in ipairs({ss,game:GetService("ReplicatedStorage"),workspace}) do
  connect(root.DescendantAdded,X.musicConsider)
  connect(root.DescendantRemoving,function(object)
   local state=X.music
   if state.sounds[object] then state.sounds[object]=nil;state.dirty=true end
   if state.folders[object] then state.folders[object]=nil;state.dirty=true end
  end)
 end
 function X.musicDiscover()
  local state=X.music
  if not state.dirty then return state.tracks end
  state.dirty=false
  local tracks={};local paths={}
  for sound,folder in pairs(state.sounds) do
   if sound.Parent and folder.Parent and sound:IsDescendantOf(folder) then
    if sound.SoundId~="" then tracks[#tracks+1]=sound;paths[sound]=sound:GetFullName() end
   else state.sounds[sound]=nil end
  end
  table.sort(tracks,function(a,b)return paths[a]<paths[b] end)
  local signature={};for _,sound in ipairs(tracks) do signature[#signature+1]=paths[sound] end
  state.tracks=tracks;state.signature=table.concat(signature,"|")
  gui:SetAttribute("MusicTrackCount",#tracks);gui:SetAttribute("MusicTrackSources",state.signature)
  return tracks
 end
 X.musicRescan()

 function X.musicSync()
  local state=X.music
  if not C.MusicOverride then if state.sound then X.musicRestore() end;return end
  local selected
  for _,sound in ipairs(X.musicDiscover()) do if sound:GetFullName()==C.MusicTrack or sound.Name==C.MusicTrack then selected=sound;break end end
  if not selected then X.musicRestore();gui:SetAttribute("MusicStatus","Choose an available track");return end
