function VG_ADAPTER_EXPORTS.budgetStartup()
    local boot=VG_ADAPTER_EXPORTS.boot
    if boot.cancelled then error("VG Client startup cancelled",0) end
    if boot.ready or os.clock()-boot.slice<.002 then return end
    -- Only the construction coroutine pauses. Native callbacks remain synchronous.
    if coroutine.running()~=boot.thread then return end
    boot.yields+=1
