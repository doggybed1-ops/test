-- MP3 assets remain within the executor's VG Client folder.
do
    X.killSound={folder=VG_ASSET_FOLDER.."/sounds",contexts=setmetatable({},{__mode="k"}),generation=0}
    local state=X.killSound
    local asset=getcustomasset or getsynasset
    function X.killSoundFilename(value)
        if type(value)~="string" or #value==0 or #value>160 or value:find("[/\\:%z]") or value=="." or value==".." then return nil end
        local ext=value:lower():match("%.([%w]+)$")
        return (ext=="mp3" or ext=="wav" or ext=="ogg") and value or nil
    end
    function X.ensureKillSoundFolder()
        assert(folderReady and type(makefolder)=="function" and type(isfolder)=="function","Potassium asset folder unavailable")
        if not isfolder(state.folder) then makefolder(state.folder) end
        if type(writefile)=="function" and type(isfile)=="function" and not isfile(state.folder.."/README.txt") then
            writefile(state.folder.."/README.txt","VG Client custom kill sounds\nDrop an MP3, WAV or OGG file in this folder.\nIn Settings > Kill sounds choose Refresh files, select the file, then enable Custom kill sound.\nFiles are used locally; they are not uploaded.\n")
        end
        return state.folder
    end
    function X.killSoundFiles()
        X.ensureKillSoundFolder()
        assert(type(listfiles)=="function","Potassium file listing unavailable")
        local entries={}
        for _,path in ipairs(listfiles(state.folder)) do
            local filename=tostring(path):gsub("\\","/"):match("([^/]+)$")
            if X.killSoundFilename(filename) and type(isfile)=="function" and isfile(state.folder.."/"..filename) then
                entries[#entries+1]={label=filename,value=filename}
            end
        end
        table.sort(entries,function(a,b)return a.label:lower()<b.label:lower() end)
        return entries
    end
    function X.killSoundStatus(message)
        state.message=message
        if state.feedback and state.feedback.Parent then state.feedback.Text=message end
        gui:SetAttribute("KillSoundStatus",message)
    end
    function X.killSoundSync(force)
        local filename=X.killSoundFilename(C.KillSoundFile)
        if not force and state.filename==filename and state.sound then state.sound.Volume=C.KillSoundVolume/100;return end
        state.generation+=1;local generation=state.generation
        if state.sound then state.sound:Destroy();state.sound=nil end
        state.filename=filename;state.loaded=false
        if not filename then X.killSoundStatus("Drop an MP3 into VG Client/sounds, then choose it.");return end
        local ok,result=pcall(function()
            X.ensureKillSoundFolder()
            assert(type(asset)=="function" and type(isfile)=="function","Local audio assets unavailable")
            local path=state.folder.."/"..filename
            assert(isfile(path),"Sound file missing: "..filename)
            local id=asset(path)
            assert(type(id)=="string" and #id>0,"Local audio asset could not be registered")
            return id
        end)
        if not ok then X.killSoundStatus(tostring(result));return end
        local created,sound=pcall(make,"Sound",{Name="VGCustomKillSound",SoundId=result,Volume=C.KillSoundVolume/100,Looped=false,PlayOnRemove=false},game:GetService("SoundService"))
        if not created then X.killSoundStatus("Audio could not be created: "..tostring(sound));return end
        state.sound=sound;X.killSoundStatus("Loading "..filename.."...")
        task.spawn(function()
            local success,message=pcall(function()game:GetService("ContentProvider"):PreloadAsync({sound}) end)
            if not alive or state.generation~=generation or state.sound~=sound then return end
            state.loaded=success and sound.IsLoaded
            X.killSoundStatus(state.loaded and ("Ready: "..filename) or ("Audio could not load: "..tostring(message or filename)))
        end)
    end
    -- Suppress only the native kill cue inside the confirmed-kill callback.
    -- Death cues, hits, firing, and other players' sounds use the original method.
    if killfeedClient and type(debug.getupvalues)=="function" then
        for _,value in pairs(VG_ADAPTER_EXPORTS.upvalues(killfeedClient.killedBy or killfeedClient.killed)) do
            if type(value)=="table" and type(rawget(value,"play"))=="function" then state.guiSounds=value;break end
        end
        if not state.guiSounds and type(X.findFunction)=="function" then
            local native=X.findFunction(killfeedClient.killed,"killed")
            if native then for _,value in pairs(VG_ADAPTER_EXPORTS.upvalues(native)) do
                if type(value)=="table" and type(rawget(value,"play"))=="function" then state.guiSounds=value;break end
            end end
        end
    end
    if state.guiSounds then
        wrapMethod(state.guiSounds,"play",function(original,name,...)
            if state.contexts[coroutine.running()] and (name=="Kill1" or name=="Kill2" or name=="Kill3") then return end
            return original(name,...)
        end)
    end
    function X.playConfirmedKill(original,victim,distance,...)
        local sound=state.sound
        local custom=C.CustomKillSound and state.guiSounds and state.loaded and sound and sound.Parent
        if not custom then return original(victim,distance,...) end
        local thread=coroutine.running();local previous=state.contexts[thread]
        state.contexts[thread]=true
        local results=table.pack(pcall(original,victim,distance,...))
        state.contexts[thread]=previous
        if not results[1] then error(results[2],0) end
        sound.Volume=C.KillSoundVolume/100;sound:Stop();sound.TimePosition=0;sound:Play()
        return table.unpack(results,2,results.n)
    end
    table.insert(X.restores,function()
