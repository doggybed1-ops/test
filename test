-- Performance changes are local, opt-in, and restored on disable or unload.
do
    local state={enabled=false,generation=0,changes={},connections={},queue={},head=1,tail=0,seen=setmetatable({},{__mode="k"})}
    X.performance=state
    local expensive={BloomEffect=true,BlurEffect=true,DepthOfFieldEffect=true,SunRaysEffect=true}
    local function current(generation)
        return alive and state.enabled and state.generation==generation
    end
    local function read(object,key)
        local ok,value=pcall(function() return object[key] end)
        return ok,value
    end
    local function property(object,key,value,generation)
        if not object or not current(generation) then return end
        local ok,before=read(object,key)
        if not ok then return end
        local entry={object=object,key=key,before=before,value=value,writing=false}
        local function impose()
            entry.writing=true
            local written=pcall(function() object[key]=value end)
            entry.writing=false
            return written
        end
        if not impose() then return end
        state.changes[#state.changes+1]=entry
        local connected,connection=pcall(function()
            return object:GetPropertyChangedSignal(key):Connect(function()
                if entry.writing or not current(generation) then return end
                local readable,nativeValue=read(object,key)
                if readable and nativeValue~=value then
                    entry.before=nativeValue
                    impose()
                end
            end)
        end)
        if connected then entry.connection=connection end
    end
    local startWorker
    local function enqueue(object,generation)
        if not object or not current(generation) or state.seen[object] then return end
        state.seen[object]=true
        state.tail+=1;state.queue[state.tail]=object
        startWorker(generation)
    end
    local function consider(object,generation)
        local ok,class=read(object,"ClassName")
        if ok and expensive[class] then property(object,"Enabled",false,generation) end
    end
    startWorker=function(generation)
        if state.worker or not current(generation) then return end
        local owner={};state.worker=owner
        task.defer(function()
            -- Let the toggle draw first, then process short batches between frames.
            task.wait()
            local slice=os.clock();local count=0
            while current(generation) and state.head<=state.tail do
                local object=state.queue[state.head];state.queue[state.head]=nil;state.head+=1
                if object then
                    consider(object,generation)
                    local ok,children=pcall(function() return object:GetChildren() end)
                    if ok then
                        for index,child in ipairs(children) do
                            if not current(generation) then break end
                            enqueue(child,generation)
                            if index%48==0 or os.clock()-slice>=.003 then
                                task.wait();slice=os.clock();count=0
                            end
                        end
                    end
                end
                count+=1
                if count>=48 or os.clock()-slice>=.003 then
                    task.wait();slice=os.clock();count=0
                end
            end
            if state.worker==owner then
                state.worker=nil
                if current(generation) then state.queue={};state.head=1;state.tail=0 end
            end
        end)
    end
    local function listen(signal,callback)
        local ok,connection=pcall(function() return signal:Connect(callback) end)
        if ok then state.connections[#state.connections+1]=connection end
    end
    function X.setPerformanceMode(on)
        if on==state.enabled then return end
        if not on then
            state.enabled=false;state.generation+=1;state.worker=nil
            for _,connection in ipairs(state.connections) do pcall(function() connection:Disconnect() end) end
            table.clear(state.connections)
            for _,entry in ipairs(state.changes) do
                if entry.connection then pcall(function() entry.connection:Disconnect() end) end
                local ok,value=read(entry.object,entry.key)
                -- A last native write still wins if its change callback has not run.
                if ok and value==entry.value then pcall(function() entry.object[entry.key]=entry.before end) end
            end
            table.clear(state.changes)
            state.queue={};state.head=1;state.tail=0;state.seen=setmetatable({},{__mode="k"})
            return
        end
        assert(alive,"VG Client is unloaded")
        state.enabled=true;state.generation+=1
        local generation=state.generation
        local lighting=game:GetService("Lighting")
        local ok,userSettings=pcall(function() return UserSettings():GetService("UserGameSettings") end)
        if ok then property(userSettings,"SavedQualityLevel",Enum.SavedQualitySetting.QualityLevel1,generation) end
        local renderOK,rendering=pcall(function() return settings().Rendering end)
        if renderOK then property(rendering,"QualityLevel",Enum.QualityLevel.Level01,generation) end
        property(lighting,"GlobalShadows",false,generation)
        local terrainOK,terrain=pcall(function() return workspace.Terrain end)
        if terrainOK then
            property(terrain,"WaterReflectance",0,generation)
            property(terrain,"WaterWaveSize",0,generation)
            property(terrain,"WaterWaveSpeed",0,generation)
        end
        listen(lighting.DescendantAdded,function(object) enqueue(object,generation) end)
        listen(workspace.DescendantAdded,function(object)
            local readable,class=read(object,"ClassName")
            if readable and expensive[class] then enqueue(object,generation) end
        end)
        listen(workspace:GetPropertyChangedSignal("CurrentCamera"),function() enqueue(workspace.CurrentCamera,generation) end)
        enqueue(lighting,generation);enqueue(workspace.CurrentCamera,generation)
    end
    table.insert(X.restores,function() X.setPerformanceMode(false) end)
end
