function X.preloadUniformAssets()
 if X.uniformAssetLoading then X.uniformAssetRerun=true;return end
 X.uniformAssetLoading=true
 task.spawn(function()
  local state=X.uniformAssetState
  local ok,err=xpcall(function()
   while alive and (not X.startup.ready or X.uniformLateCaptureActive or X.assetDemandActive or X.diskGear.restorePending or X.diskGear.restoring) do task.wait(.1) end
   if not alive then return end
   X.diskGear.restoring=true
   local restored,restoreError=xpcall(function()
    X.loadDiskGear("uniform",X.uniformModelCache)
    if alive then X.loadDiskGear("weapon",X.weaponCache) end
   end,debug.traceback)
   X.diskGear.restoring=false
   task.defer(function()table.clear(X.diskGear.restoringModels)end)
   if not restored then error(restoreError,0) end
   if not alive then return end
   local storage=game:GetService("ReplicatedStorage"):FindFirstChild("LoadoutsStorage")
   local models=storage and storage:FindFirstChild("Models")
   if not models then state.status="Uniform assets are not available in this place";return end
   local provider=game:GetService("ContentProvider")
   local names,ids={},{};local slice=os.clock()
   local function gear(desc)
    if type(desc)=="string" then names[desc]=true
    elseif type(desc)=="table" then
     if desc.ModelName then names[desc.ModelName]=true end
     for _,entry in pairs(desc.RandomOptions or {}) do gear(entry.Model) end
     for _,entry in pairs(desc.Models or {}) do gear(entry) end
     for _,entry in pairs(desc.BackpackModels or {}) do gear(entry) end
    end
   end
   local function clothing(value)
    if type(value)=="number" or type(value)=="string" then local id=X.clothingAsset(value);if id then ids[id]=true end
    elseif type(value)=="table" then for _,entry in pairs(value.RandomOptions or {}) do clothing(entry.Id) end end
   end
   for _,outfit in pairs(X.loadouts or {}) do
    if type(outfit)=="table" then
     for _,key in ipairs({"Hat","FatigueHat","BicorneHat","Backpack"}) do gear(outfit[key]) end
     for _,entry in pairs(outfit.Equipment or {}) do gear(entry) end
     for _,key in ipairs({"Shirt","Pants","FatigueShirt","FatiguePants","GreatcoatShirt","GreatcoatPants","CampaignShirt","CampaignPants"}) do clothing(outfit[key]) end
    end
    local running
    slice,running=X.preparationCheckpoint(slice)
    assert(running,"Uniform preparation cancelled")
   end
   X.recoverUniformModels(names)
   if not alive then return end
   state.missing={};state.failed={};state.loaded=0
   for name in pairs(names) do
    local model=X.uniformModel(name);if not model then state.missing[#state.missing+1]=name end
    local running
    slice,running=X.preparationCheckpoint(slice)
    assert(running,"Uniform preparation cancelled")
   end
   table.sort(state.missing)
   local queue={}
   for _,model in ipairs(models:GetChildren()) do if model:IsA("Model") and not X.uniformModelCache:FindFirstChild(model.Name) then queue[#queue+1]=model end end
   for _,model in ipairs(X.uniformModelCache:GetChildren()) do queue[#queue+1]=model end
   state.models=#queue
   for id in pairs(ids) do queue[#queue+1]=id end
   local completed,total=0,#queue
   local function progress()
    state.status=string.format("Preloading uniforms: %d / %d groups",completed,total)
    if alive then gui:SetAttribute("UniformLoadStatus",state.status) end
   end
   local function fetched(id,status)
    if status==Enum.AssetFetchStatus.Success then
     state.failed[id]=nil;state.loaded+=1
    else state.failed[id]=tostring(status) end
   end
   progress()
   local nextIndex,workers=1,1
   for worker=1,1 do
    task.spawn(function()
     while alive do
      local first=nextIndex;nextIndex+=16
      if first>#queue then break end
      local last=math.min(first+15,#queue);local batch={}
      for j=first,last do batch[#batch+1]=queue[j] end
      local success,why=pcall(provider.PreloadAsync,provider,batch,fetched)
      if not success then state.failed["batch "..first]=tostring(why) end
      completed+=last-first+1;progress();task.wait()
     end
     workers-=1
    end)
   end
   while alive and workers>0 do task.wait(.1) end
   if not alive then return end
   -- A second fetch retries transient mesh / texture failures once.
   local retry={}
   for id in pairs(state.failed) do if not string.find(id,"batch ",1,true) then retry[#retry+1]=id end end
   for first=1,#retry,16 do
    if not alive then return end
    local batch={}
    for j=first,math.min(first+15,#retry) do batch[#batch+1]=retry[j] end
    pcall(provider.PreloadAsync,provider,batch,fetched)
    task.wait()
   end
   local failed=0;for _ in pairs(state.failed) do failed+=1 end
   state.status=string.format("Uniforms: %d cached • %d missing models • %d fetch failures",#X.uniformModelCache:GetChildren(),#state.missing,failed)
   if alive then
    gui:SetAttribute("UniformMissingModels",#state.missing)
    gui:SetAttribute("UniformFetchFailures",failed)
    X.uniformAssetsRevision+=1
    X.queueUniform()
   end
  end,debug.traceback)
  if not ok then state.status="Uniform preload error: "..tostring(err) end
  X.uniformAssetLoading=false
  if alive then
   gui:SetAttribute("UniformLoadStatus",state.status)
   print("VG_UNIFORM_ASSETS",state.status)
   if X.uniformAssetRerun then X.uniformAssetRerun=false;task.delay(1,function()if alive then X.preloadUniformAssets() end end) end
  end
 end)
end
do
 local storage=game:GetService("ReplicatedStorage"):FindFirstChild("LoadoutsStorage")
 local models=storage and storage:FindFirstChild("Models")
 local pending=false
 X.uniformLateCaptureActive=false
 if models then
  local arrived={}
  local function drainArrivals()
   if pending or not alive then return end
   pending=true
   task.delay(1,function()
    local ok,err=xpcall(function()
     while alive and next(arrived) do
      -- Only one capture/preload owner can run. The main preload waits for the
      -- active owner, not this pending drainer, so neither waits for itself.
      while alive and (not X.startup.ready or X.uniformAssetLoading or X.assetDemandActive or X.diskGear.restorePending or X.diskGear.restoring) do task.wait(.1) end
      if not alive then return end
      X.uniformLateCaptureActive=true
      local batch={}
      for item in pairs(arrived) do if item.Parent==models then batch[#batch+1]=item end end
      table.clear(arrived)
      -- Keep an exact copy before the server retires an unused model.
      local slice=os.clock()
      for _,item in ipairs(batch) do
       if not alive then return end
       X.cacheUniformModel(item)
       local running
       slice,running=X.preparationCheckpoint(slice)
       if not running then return end
      end
      gui:SetAttribute("UniformCachedModels",#X.uniformModelCache:GetChildren())
      X.uniformAssetsRevision+=1;X.queueUniform()
      local missing={}
      for _,name in ipairs(X.uniformAssetState.missing) do
       local m=X.uniformModel(name,false)
       if not m then missing[#missing+1]=name end
      end
      X.uniformAssetState.missing=missing;gui:SetAttribute("UniformMissingModels",#missing)
      for first=1,#batch,16 do
       if not alive then return end
       local group={}
       for j=first,math.min(first+15,#batch) do group[#group+1]=batch[j] end
       pcall(function()game:GetService("ContentProvider"):PreloadAsync(group)end)
       task.wait()
      end
      X.uniformLateCaptureActive=false
      task.wait()
     end
    end,debug.traceback)
    X.uniformLateCaptureActive=false;pending=false
    if not alive then table.clear(arrived);return end
    if not ok then warn("VG Client late uniform preparation: "..tostring(err)) end
    if next(arrived) then drainArrivals() end
   end)
  end
  connect(models.DescendantAdded,function(object)
   local root=object
   while root.Parent and root.Parent~=models do root=root.Parent end
   if root.Parent==models and X.uniformNeededNames[root.Name] then
    arrived[root]=true
    X.assetDemand.attempted["uniform:"..root.Name]=nil
    drainArrivals()
   end
  end)
 end
end
