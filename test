                for _,class in pairs(classes.byIdentifier) do
                    for field,kind in pairs({staminaLossVariable="loss",staminaGainVariable="gain",staminaGainMaxSpeedVariable="speed"}) do
                        if type(class[field])=="string" then horseVariableKeys[class[field]]=kind end
                    end
                end
            end
