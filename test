        elseif key=="TargetUsername" or key=="PlayerESPUsername" or key=="AutomationCommander" then return #value<=20 and (value=="" or value:match("^[%w_]+$")~=nil)
        end
        return #value<=250 and not value:find("[%z\1-\31]")
    end
    function X.config.normalize(input,strict)
        assert(type(input)=="table","Invalid settings")
        local output=table.clone(defaults)
        local report={nullKeys={},updatedKeys={},reasons={}}
        local count=0
        local function omit(key,reason)
            if strict then error(reason..": "..key,0) end
            report.nullKeys[key]=true;report.reasons[key]=reason
        end
        for key,value in pairs(input) do
            count+=1;assert(count<=512 and validKey(key),"Invalid settings object")
            if retired[key] or defaults[key]==nil then omit(key,"Outdated feature");continue end
            if type(value)~=type(defaults[key]) then omit(key,"Outdated value type");continue end
            if type(value)=="number" then
                if value~=value or math.abs(value)==math.huge then omit(key,"Invalid number");continue end
                local bounds=ranges[key]
                if not bounds then omit(key,"Unavailable value range");continue end
                if strict then assert(value>=bounds[1] and value<=bounds[2],"Out of range: "..key) end
                local clamped=math.clamp(value,bounds[1],bounds[2])
                if key=="UniformStyle" or key=="UniformHat" or key=="BuffFormation" or key=="LowRankGroupId" or key=="LowRankMax" then clamped=math.floor(clamped+.5) end
                if value~=clamped then report.updatedKeys[key]=true end
                value=clamped
            elseif type(value)=="string" then
                if key=="PriorityKey" and value=="F1" and not strict then value="V";report.updatedKeys[key]=true end
                if not validString(key,value) then omit(key,"Outdated selection");continue end
            end
            output[key]=value
        end
        -- A vanished selection cannot leave a dependent feature switched on.
        if not strict then
            for selection,enablers in pairs({UniformName={"UniformOverride","UniformWeaponDrawn"},UniformWeaponName={"UniformWeaponDrawn"},KillSoundFile={"CustomKillSound"},MusicTrack={"MusicOverride"}}) do
                if report.nullKeys[selection] or output[selection]=="" then
                    for _,key in ipairs(enablers) do if output[key] then output[key]=false;report.nullKeys[key]=true;report.reasons[key]="Unavailable selection" end end
                end
            end
        end
        if output.BulletPOV then output.InstantHit=false;output.Missle=false
        elseif output.Missle then output.InstantHit=false end
        if output.ArtFly then output.ArtSilent=false;output.ArtAim=false end
        return output,finish(report)
    end
    -- JSONDecode drops null object members. Read their escaped names separately.
    local function nullFields(raw,envelope)
        local result={};local depth=0;local wanted;local settingsAt
        if not envelope then wanted=1 end
        local index=1
        local quoteBoundary='["'..string.char(92)..']'
        local function nextText(at)
            return raw:find("%S",at) or (#raw+1)
        end
        while index<=#raw do
            index=raw:find('["{}%[%]]',index)
            if not index then break end
            local char=raw:sub(index,index)
            if char=='"' then
                local first=index;local cursor=index+1
                while cursor<=#raw do
                    local boundary=raw:find(quoteBoundary,cursor)
                    assert(boundary,"Invalid JSON string")
                    if raw:sub(boundary,boundary)=='"' then index=boundary;break end
                    cursor=boundary+2
                end
                local token=raw:sub(first,index)
                local colon=nextText(index+1)
                if raw:sub(colon,colon)==":" then
                    local valueAt=nextText(colon+1)
                    if depth==1 and envelope then
                        local key=Http:JSONDecode(token)
                        if key=="settings" then assert(raw:sub(valueAt,valueAt)=="{","Invalid settings object");settingsAt=valueAt end
                    end
                    if depth==wanted and raw:sub(valueAt,valueAt+3)=="null" then
                        local key=Http:JSONDecode(token);assert(validKey(key),"Invalid null setting");result[key]=true
                    end
                end
            elseif char=="{" or char=="[" then depth+=1;if index==settingsAt then wanted=depth end
            elseif char=="}" or char=="]" then depth-=1;if envelope and wanted and depth<wanted then wanted=nil end
            end
            index+=1
        end
        return result
    end
    function X.config.decode(raw)
        assert(type(raw)=="string" and #raw>0 and #raw<=262144,"Profile is empty or too large")
        assert(raw:match("^%s*{"),"Import a VG Client JSON profile")
        local document=Http:JSONDecode(raw)
        assert(type(document)=="table","Invalid profile")
        local envelope=document.settings~=nil
        local input
        if envelope then
            assert(type(document.settings)=="table","Invalid profile settings")
            assert(document.version==nil or type(document.version)=="number" and document.version==document.version and document.version>=1 and document.version<=1000000 and document.version%1==0,"Invalid profile version")
            assert(document.kind==nil or document.kind=="VGClientConfig","Not a VG Client profile")
            input=document.settings
        else
            local known=false
            for key in pairs(document) do if defaults[key]~=nil or retired[key] then known=true;break end end
            assert(known,"Not a VG Client profile");input=document
        end
        local settings,report=X.config.normalize(input)
        local explicit=nullFields(raw,envelope)
        if envelope and document.nullSettings~=nil then
            assert(type(document.nullSettings)=="table","Invalid null settings metadata")
            local count=0
            for index,key in pairs(document.nullSettings) do
                count+=1;assert(count<=512 and type(index)=="number" and index>=1 and index%1==0 and validKey(key),"Invalid null settings metadata")
                -- A current non-null value wins over stale migration metadata.
                if input[key]==nil then explicit[key]=true end
            end
        end
        local count=0
        for key in pairs(explicit) do
            count+=1;assert(count<=512,"Too many null settings")
            if input[key]~=nil then continue end
            report.nullKeys[key]=true;report.reasons[key]="Null feature"
            if defaults[key]~=nil then settings[key]=defaults[key] end
        end
        for selection,enablers in pairs({UniformName={"UniformOverride","UniformWeaponDrawn"},UniformWeaponName={"UniformWeaponDrawn"},KillSoundFile={"CustomKillSound"},MusicTrack={"MusicOverride"}}) do
            if report.nullKeys[selection] then for _,key in ipairs(enablers) do if settings[key] then settings[key]=false;report.nullKeys[key]=true;report.reasons[key]="Unavailable selection" end end end
        end
        report.sourceVersion=envelope and (document.version or 0) or 0
        report.sourcePlaceId=envelope and document.placeId or nil
        return settings,finish(report)
    end
    function X.config.encode(settings,nullKeys)
        local values,report=X.config.normalize(settings)
        local nulls=table.clone(report.nullKeys)
        for key in pairs(nullKeys or {}) do
            assert(validKey(key),"Invalid null setting")
            if retired[key] or defaults[key]==nil or values[key]==defaults[key] then nulls[key]=true end
        end
        local all={};for key in pairs(values) do all[key]=true end;for key in pairs(nulls) do all[key]=true end
        local nullNames=sortedKeys(nulls);assert(#nullNames<=512,"Too many null settings")
        local allNames=sortedKeys(all);assert(#allNames<=512,"Too many profile settings")
        local parts={}
        for _,key in ipairs(allNames) do
            parts[#parts+1]=Http:JSONEncode(key)..":"..(nulls[key] and "null" or Http:JSONEncode(values[key]))
        end
        return '{"kind":"VGClientConfig","version":2,"placeId":'..Http:JSONEncode(game.PlaceId)..',"settings":{'..table.concat(parts,",")..'},"nullSettings":'..Http:JSONEncode(nullNames)..'}'
    end
    function X.config.summary(report)
        local obsolete=#(report and report.nullSettings or {})
        local updated=#(report and report.updatedSettings or {})
        local result={}
        if obsolete>0 then result[#result+1]=tostring(obsolete).." outdated setting"..(obsolete==1 and "" or "s").." left null" end
        if updated>0 then result[#result+1]=tostring(updated).." value"..(updated==1 and "" or "s").." updated" end
        return table.concat(result,"; ")
    end
    function X.config.readImport(value)
        assert(type(value)=="string" and #value>0,"Paste config JSON or a .json file path")
        if value:match("^%s*[{[]") then assert(#value<=262144,"Profile is too large");return value end
        assert(#value<=512 and not value:find("[%z\1-\31]"),"Invalid profile path")
        local path=value:gsub(string.char(92),"/")
        assert(not path:find(":",1,true) and path:sub(1,1)~="/","Use a path inside your executor workspace")
        for part in path:gmatch("[^/]+") do assert(part~="." and part~="..","Use a path inside your executor workspace") end
        assert(path:lower():match("%.json$"),"Choose a .json file")
        assert(type(readfile)=="function","Filesystem unavailable")
        local raw=readfile(path);assert(type(raw)=="string" and #raw<=262144,"Profile is too large");return raw
    end
    function X.config.import(value,name)
        name=checkedName(name)
        local settings,report=X.config.decode(X.config.readImport(value))
        local raw=X.config.encode(settings,report.nullKeys)
        ensureConfigs();writefile(configFolder.."/"..name..".json",raw)
        X.config.savedNullSettings[name:lower()]=table.clone(report.nullKeys)
        report.name=name;X.config.lastReport=report
        return report
    end
    function X.config.export(name)
        name=checkedName(name)
        local settings,report=X.config.normalize(C)
        local raw=X.config.encode(settings,X.config.activeNullSettings)
        ensureConfigs();local folder=configFolder.."/exports"
        if not isfolder(folder) then makefolder(folder) end
        local path=folder.."/"..name..".json";writefile(path,raw)
        local _,encodedReport=X.config.decode(raw)
        encodedReport.updatedKeys=report.updatedKeys;encodedReport.updatedSettings=report.updatedSettings
        report=encodedReport;X.config.lastReport=report
        return raw,path,report
    end
    function X.config.openFolder()
        local folder=ensureConfigs()
        local opener=type(openfolder)=="function" and openfolder or type(open_folder)=="function" and open_folder
        if opener then local ok,result=pcall(opener,folder);if ok and result~=false then return "Opened "..folder,true end end
        local copy=type(setclipboard)=="function" and setclipboard or type(toclipboard)=="function" and toclipboard
        local copied=type(copy)=="function" and pcall(copy,folder)
        return "Open your executor workspace, then "..folder.."."..(copied and " Path copied." or ""),false
    end
end
local function validatedSettings(input,strict)
    return X.config.normalize(input,strict)
end
local function applySettings(input,migration)
    local wanted,report=validatedSettings(input)
    report=migration or report
    local previous=table.clone(C)
    local function apply(values)
        for _,key in ipairs((function()local result={};for k in pairs(C)do result[#result+1]=k end;table.sort(result);return result end)()) do if type(C[key])=="boolean" and C[key] then setSetting(key,false) end end
        local keys={};for key in pairs(values)do keys[#keys+1]=key end;table.sort(keys)
        for _,key in ipairs(keys) do if type(values[key])~="boolean" then setSetting(key,values[key]) end end
        for _,key in ipairs(keys) do if type(values[key])=="boolean" and values[key] and key~="UniformWeaponDrawn" then setSetting(key,true) end end
        if values.UniformWeaponDrawn then setSetting("UniformWeaponDrawn",true) end
    end
    local ok,err=pcall(apply,wanted)
    if not ok then
        local restored,restoreError=pcall(apply,previous)
        if not restored then warn("Profile rollback: "..tostring(restoreError)) end
    end
    activeLock=nil;previewTarget=nil
    if X.syncUniformChants then X.syncUniformChants() end
    if bonusGuiClient then pcall(bonusGuiClient.setFormationMoraleIcon,X.naturalFormation) end
    for _,fn in ipairs(refreshers) do fn() end
    assert(ok,tostring(err))
    X.config.activeNullSettings=table.clone(report.nullKeys);X.config.lastReport=report
    return report
end
local function saveProfile(name)
    ensureConfigs();name=checkedName(name)
    local inherited=table.clone(X.config.activeNullSettings)
    local cached=X.config.savedNullSettings[name:lower()]
    if not cached and type(isfile)=="function" and isfile(configFolder.."/"..name..".json") then
        local ok,_,report=pcall(function()return X.config.decode(readfile(configFolder.."/"..name..".json"))end)
        if ok then cached=report.nullKeys end
    end
    for key in pairs(cached or {}) do inherited[key]=true end
    local raw=X.config.encode(C,inherited)
    writefile(configFolder.."/"..name..".json",raw)
    local _,report=X.config.decode(raw);X.config.savedNullSettings[name:lower()]=table.clone(report.nullKeys);X.config.lastReport=report
    return report
end
local function loadProfile(name)
    ensureConfigs();name=checkedName(name)
    local settings,report=X.config.decode(readfile(configFolder.."/"..name..".json"))
    applySettings(settings,report)
    X.config.savedNullSettings[name:lower()]=table.clone(report.nullKeys)
    return report
end
