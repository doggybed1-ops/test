-- Silent shots keep native flight and contact handling while ignoring map cover.
do
    local nativeWorkspace=workspace
    local contexts=setmetatable({},{__mode="k"})
    local mainThread={}
    local coverCaches=setmetatable({},{__mode="k"})
    local environments={}
    X.silentCoverReady=false
    X.silentMuzzleReady=false

    local function actorPart(part)
        if part:IsA("BasePart") then
            -- Static map geometry can share character collision groups.
            -- A registered horse or character model identifies an actor.
            if X.damage and type(X.damage.getHorseByModelPart)=="function" then
                local ok,horse=pcall(X.damage.getHorseByModelPart,part)
                if ok and horse then return true end
            end
        end
        local ancestor=part
        while ancestor and ancestor~=nativeWorkspace do
            if ancestor.Name=="TargetModel" or ancestor:FindFirstChildOfClass("Humanoid") then return true end
            if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then return true end
            ancestor=ancestor.Parent
        end
        return false
    end

    local function filteredRaycast(origin,direction,nativeParams)
        local context=contexts[coroutine.running() or mainThread]
        if not context or typeof(nativeParams)~="RaycastParams" or nativeParams.FilterType~=Enum.RaycastFilterType.Exclude then
            return nativeWorkspace:Raycast(origin,direction,nativeParams)
        end
        local cache=coverCaches[context.projectile]
        if not cache then cache={parts={},seen={}};coverCaches[context.projectile]=cache end
        local copied,params=pcall(function()
            local replacement=RaycastParams.new()
            replacement.FilterType=nativeParams.FilterType
            replacement.CollisionGroup=nativeParams.CollisionGroup
            replacement.IgnoreWater=nativeParams.IgnoreWater
            for _,property in ipairs({"RespectCanCollide","BruteForceAllSlow"}) do
                pcall(function() replacement[property]=nativeParams[property] end)
            end
            local ignore=table.clone(nativeParams.FilterDescendantsInstances)
            -- Cached map parts can be reparented or become an actor later.
            local retained,seen={},{}
            for _,part in ipairs(cache.parts) do
                if part.Parent and not actorPart(part) then
                    table.insert(ignore,part);table.insert(retained,part);seen[part]=true
                end
            end
            while #retained>512 do seen[table.remove(retained,1)]=nil end
            cache.parts=retained;cache.seen=seen
            replacement.FilterDescendantsInstances=ignore
            return replacement
        end)
        if not copied then return nativeWorkspace:Raycast(origin,direction,nativeParams) end
        local lastObstruction
        for _=1,128 do
            local ok,hit=pcall(nativeWorkspace.Raycast,nativeWorkspace,origin,direction,params)
            if not ok then
                if lastObstruction then return lastObstruction end
                error(hit,0)
            end
            if not hit then return nil end
            local part=hit.Instance
            if actorPart(part) or not (part:IsA("BasePart") or part:IsA("Terrain")) then return hit end
            lastObstruction=hit
            if not cache.seen[part] then
                cache.seen[part]=true;table.insert(cache.parts,part)
            end
            local ignored=pcall(function() params:AddToFilter(part) end)
            if not ignored then return hit end
        end
        -- A very dense segment must stop instead of claiming an unresolved hit.
        return lastObstruction
    end

    local function installEnvironment(callback)
        local visited={}
        while VG_ADAPTER_EXPORTS.nativeOriginals[callback] and not visited[callback] do
            visited[callback]=true;callback=VG_ADAPTER_EXPORTS.nativeOriginals[callback]
        end
        if type(callback)~="function" or type(getfenv)~="function" or type(setfenv)~="function" then
            return false,"Native environment adapter unavailable"
        end
        local installedEnvironment,previousEnvironment
        local ok,reason=pcall(function()
            previousEnvironment=getfenv(callback)
            -- Game environments may protect their metatable. Copy entries and
            -- retain inherited lookups without cloning that protected table.
            installedEnvironment={}
            for key,value in pairs(previousEnvironment) do installedEnvironment[key]=value end
            setmetatable(installedEnvironment,{__index=previousEnvironment})
            local proxy=setmetatable({Raycast=function(_,origin,direction,params)
                return filteredRaycast(origin,direction,params)
            end},{__index=nativeWorkspace})
            installedEnvironment.workspace=proxy
            setfenv(callback,installedEnvironment)
            assert(getfenv(callback)==installedEnvironment,"Native environment was not replaced")
        end)
        if not ok then
            if previousEnvironment and installedEnvironment then
                pcall(function()
                    if getfenv(callback)==installedEnvironment then setfenv(callback,previousEnvironment) end
                end)
            end
            return false,tostring(reason)
        end
        table.insert(environments,{callback=callback,installed=installedEnvironment,previous=previousEnvironment})
        return true
    end
    X.silentCoverReady,X.silentCoverError=installEnvironment(originalSim)

    -- The native Fire method checks map cover behind the muzzle before creating
    -- a projectile. Keep that check for actors and ordinary manual shots.
    if fireClass and type(fireClass.Fire)=="function" and type(wrapMethod)=="function" then
        X.silentMuzzleReady,X.silentMuzzleError=installEnvironment(fireClass.Fire)
        if X.silentMuzzleReady then
            wrapMethod(fireClass,"Fire",function(original,self,...)
                local thread=coroutine.running() or mainThread
                local previous=contexts[thread]
                local localAction=type(self)=="table" and (self==X.currentFireAction or X.fireActions and X.fireActions[self])
                local active=alive and X.silentMuzzleReady and C.SilentAim and not C.BulletPOV and localAction
                local scope={}
                contexts[thread]=active and {projectile=scope} or nil
                local results=table.pack(pcall(original,self,...))
                contexts[thread]=previous;coverCaches[scope]=nil
                if not results[1] then error(results[2],0) end
                return table.unpack(results,2,results.n)
            end)
        end
    else X.silentMuzzleError="Native firearm action unavailable" end

    function X.simulateSilentShot(selection,projectile,dt,gravity)
        local thread=coroutine.running() or mainThread
        local previous=contexts[thread]
        local active=alive and X.silentCoverReady and C.SilentAim and projectile.isLocal and not C.BulletPOV
            and X.shotTargetValid(selection)
        contexts[thread]=active and {projectile=projectile,selection=selection} or nil
        local results=table.pack(pcall(X.withShotDamageContext,selection,originalSim,projectile,dt,gravity))
        contexts[thread]=previous
        if not results[1] then coverCaches[projectile]=nil;error(results[2],0) end
        return table.unpack(results,2,results.n)
    end
    table.insert(X.restores,function()
        table.clear(contexts);table.clear(coverCaches)
        for index=#environments,1,-1 do
            local state=environments[index]
            pcall(function()
                if getfenv(state.callback)==state.installed then setfenv(state.callback,state.previous) end
            end)
        end
        table.clear(environments)
        X.silentCoverReady=false;X.silentMuzzleReady=false
    end)
end

