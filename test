            X.cancelAutomationAim();s.status="Equip a ready firearm";return
        end
        if s.action and s.action~=action then X.cancelAutomationAim() end
        if s.reloadAction and not s.reloadAction.reloading then s.reloadAction=nil;s.ownsReload=false end
        if not fireClass.reloaded then
            if s.action then X.cancelAutomationAim() end
