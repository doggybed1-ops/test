if not reportState.current then newBattleReport() end
local function formatBattleReport(report)
    local lines={"VG CLIENT - BATTLE KILLS","Battle: "..report.name,"Recorded from: "..report.started,
        "Player: @"..P.Name.." ("..P.UserId..")","Server: "..game.JobId,
        "Confirmed kills recorded: "..#report.kills,
        "Kills before tracking began (names unavailable): "..tostring(report.priorKills),
        "Battle status: "..(report.ended or "In progress"),"", "TIME (UTC) | USERNAME | USER ID | DISTANCE (studs)"}
    for _,kill in ipairs(report.kills) do
        table.insert(lines,string.format("%s | @%s | %s | %s",kill.time,kill.name,tostring(kill.userId),tostring(kill.distance)))
    end
    if #report.kills==0 then table.insert(lines,"No confirmed player kills recorded yet.") end
    return table.concat(lines,"\n").."\n"
end
local function exportBattle(report)
    report=report or reportState.current
    assert(folderReady and type(writefile)=="function","Report folder unavailable")
    writefile(report.file,formatBattleReport(report))
    report.saved=true
    setReportStatus("Saved "..#report.kills.." kills: "..report.file)
    return report.file
end
local function tryAutoExport()
    if C.AutoKillExport then
        local ok,err=pcall(exportBattle)
        if not ok then setReportStatus("Export failed: "..tostring(err)) end
    end
end
