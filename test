    reportState.current={id=id,name=name and tostring(name.Value) or "Battle",map=map and map.Name or "",
        started=os.date("!%Y-%m-%d %H:%M:%S UTC"),kills={},priorKills=P:GetAttribute("Kills") or 0,
        file=VG_ASSET_FOLDER.."/battle_"..id..".txt"}
    if X.resetKillPace then X.resetKillPace(true) end
