                s.nextAttempt=os.clock()+(loaded and not fireClass.reloaded and math.max(2,(s.shotDistance or 0)/(action.projectileSpeed or 860)+1) or 2)
                s.status=loaded and not fireClass.reloaded and "Shot fired; awaiting confirmed kill" or "Shot blocked; retrying when clear"
