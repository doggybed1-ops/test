            if type(rawget(t,"killed"))=="function" and type(rawget(t,"killedBy"))=="function" and type(rawget(t,"hitTargetKillfeed"))=="function" then killfeedClient=t end
            local okHorse,loss=pcall(function() return t.HorseStaminaLoss end)
