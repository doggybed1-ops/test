-- Local UI API also permits validation without firing a weapon or changing combat.
local profileAPI=make("BindableFunction",{Name="Profiles"},gui)
profileAPI.OnInvoke=function(command,value)
    if command=="snapshot" then return table.clone(C)
    elseif command=="set" then
        assert(type(value)=="table" and type(value.key)=="string" and defaults[value.key]~=nil,"Unknown setting")
        local validated=validatedSettings({[value.key]=value.value},true)
        setSetting(value.key,validated[value.key])
        for _,refresh in ipairs(refreshers) do refresh() end
        return C[value.key]
    elseif command=="killPace" then return X.getKillPace(value or C.TargetKills)
    elseif command=="paceExample" then return X.computeKillPace(value.kills,value.target,value.elapsed,value.duration,value.ended)
