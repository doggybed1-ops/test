X.startup={ready=false,queue={},queued={},running=false,yields=0,workSeconds=0}
function X.preparationCheckpoint(slice)
    local now=os.clock()
    if not alive then return now,false end
    if now-slice>=.002 then
        -- Native/executor callbacks may be non-yieldable. Budgeted preparation
        -- can continue synchronously there, without failing inside a frame event.
        if type(coroutine.isyieldable)~="function" or not coroutine.isyieldable() then return now,alive end
        X.startup.workSeconds+=now-slice
        X.startup.yields+=1
        task.wait()
        slice=os.clock()
    end
    return slice,alive
end
-- Heap discovery has one owner. Signals only enqueue work; they never scan or pause.
X.runtimeDiscovery={jobs={},pending={},running=false,passes=0,requested=false,requestedKeys={}}
X.runtimeDiscovery.settingJobs={
    Aim={"melee actions"},ArtAim={"melee actions"},
    SilentAim={"fire actions"},AutoTargetKills={"fire actions","melee actions"},
    FullReloadWalkSpeed={"fire actions"},FullAimWalkSpeed={"fire actions"},
    NoReloadWalkPenalty={"fire actions"},ShotPreview={"fire actions"},
    BayonetRangeEnabled={"melee actions"},CavAutoSwing={"melee actions"},
    InstantFlagPickup={"flag rigs"},FlagRangeEnabled={"flag rigs"},
    SkipRespawnTimer={"flag spawns"},IgnoreSpawnConditions={"flag spawns"},
    KeepFlagSpawnPrompt={"flag spawns"},AimWarning={"aim animations"},
}
X.runtimeDiscovery.dispatch=function()
    local state=X.runtimeDiscovery
    if not alive or not state.requested then return end
    local needed=false
    for _,job in ipairs(state.jobs) do if state.requestedKeys[job.key] then needed=true;break end end
    if not needed then return end
    X.deferStartupTask("runtime discovery",function()
        if state.running then return end
        state.running=true
        local function fail(entry,reason,quiet)
            entry.failed=true
            if not quiet and not entry.warned and alive then
                entry.warned=true
                warn("VG Client "..entry.key.." discovery: "..tostring(reason))
            end
        end
        while alive and #state.jobs>0 do
            -- Unused feature classifiers stay dormant without allocating a heap snapshot.
            local jobs,waiting={},{}
            for _,entry in ipairs(state.jobs) do
                if state.requestedKeys[entry.key] then jobs[#jobs+1]=entry
                else waiting[#waiting+1]=entry end
            end
            state.jobs=waiting
            if #jobs==0 then break end
            state.passes+=1
            local available=type(getgc)=="function"
            local ok,objects=false,"Heap discovery unavailable"
            if available then
                ok,objects=pcall(function() return getgc(true) end)
            elseif not state.unavailableWarned then
                state.unavailableWarned=true
                warn("VG Client heap discovery unavailable; existing-object adapters were skipped")
            end
            if ok and type(objects)=="table" then
                local count=#objects
                local slice,processed=os.clock(),0
                for index=1,count do
                    if not alive then break end
                    local value=objects[index]
                    objects[index]=nil -- Do not retain already processed heap objects.
                    if type(value)=="table" then
                        for _,entry in ipairs(jobs) do
                            if not entry.failed then
                                local visited,reason=pcall(entry.visit,value)
                                if not visited then fail(entry,reason) end
                            end
                        end
                    end
                    processed+=1
                    if processed>=128 then
                        processed=0
                        if os.clock()-slice>=.0015 then
                            -- This is a preparation worker, never a signal callback.
                            task.wait()
                            slice=os.clock()
                        end
                    end
                end
                table.clear(objects)
                objects=nil
            else
                for _,entry in ipairs(jobs) do fail(entry,ok and "Invalid heap snapshot" or objects,not available) end
            end
            for _,entry in ipairs(jobs) do
                state.pending[entry.key]=nil
                if alive and entry.complete then
                    local finished,reason=pcall(entry.complete,not entry.failed)
                    if not finished then fail(entry,reason) end
                end
                entry.visit=nil;entry.complete=nil
            end
            table.clear(jobs)
            if alive and #state.jobs>0 then task.wait() end
        end
        state.running=false
        if not alive then table.clear(state.jobs);table.clear(state.pending) end
    end)
end
function X.scanRuntimeObjects(key,visit,complete)
    local state=X.runtimeDiscovery
    if not alive or state.pending[key] then return false end
    local job={key=key,visit=visit,complete=complete,failed=false,warned=false}
    state.pending[key]=job
    state.jobs[#state.jobs+1]=job
    if state.requestedKeys[key] then state.dispatch() end
    return true
end
function X.requestRuntimeDiscovery(setting)
    local state=X.runtimeDiscovery
    if not state.settingJobs[setting] then return end
    local wanted={}
    for key,jobs in pairs(state.settingJobs) do
        if C[key]==true then for _,job in ipairs(jobs) do wanted[job]=true end end
    end
    state.requestedKeys=wanted
    state.requested=next(wanted)~=nil
    if state.requested then state.dispatch() end
end
function X.startPreparationQueue()
    local state=X.startup
    if not state.ready or state.running or not alive or #state.queue==0 then return end
    state.running=true
    task.delay(.35,function()
        while alive and #state.queue>0 do
            local job=table.remove(state.queue,1)
            local ok,err=xpcall(job.callback,debug.traceback)
            state.queued[job.key]=nil
            if not ok and alive then warn("VG Client preparation: "..tostring(err)) end
            if alive then task.wait() end
        end
        state.running=false
        if not alive then table.clear(state.queue);table.clear(state.queued) end
    end)
end
function X.deferStartupTask(key,callback)
    local state=X.startup
    if not alive or state.queued[key] then return end
    state.queued[key]=true
    state.queue[#state.queue+1]={key=key,callback=callback}
    X.startPreparationQueue()
end

