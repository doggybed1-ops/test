-- Instant attachment uses the native bayonet request and skips only its local transition.
do
    local musket
    for _,module in ipairs(getloadedmodules()) do
        if not module:IsDescendantOf(game:GetService("CorePackages")) then
            local ok,value=VGRequire(module)
            if ok and type(value)=="table" and rawget(value,"ClassName")=="MusketClient" then musket=value;break end
        end
    end
    if musket and type(musket.ToggleBayonet)=="function" and type(musket.MoveEdge)=="function" then
        local event
        for _,value in pairs(VG_ADAPTER_EXPORTS.upvalues(musket.ToggleBayonet)) do
            if type(value)=="table" or typeof(value)=="Instance" then
                local ok,fire=pcall(function() return value.FireServer end)
                if ok and type(fire)=="function" then event=value;break end
            end
        end
        local helpers={}
        for _,value in pairs(VG_ADAPTER_EXPORTS.upvalues(musket.MoveEdge)) do
            if type(value)=="table" then
                if type(rawget(value,"load"))=="function" then helpers.tracks=value end
                if type(rawget(value,"setWalkSpeed"))=="function" then helpers.character=value end
                if type(rawget(value,"setCombatCameraLocked"))=="function" then helpers.movement=value end
                if type(rawget(value,"playWeaponSound"))=="function" then helpers.sounds=value end
            end
        end
        if event and helpers.tracks and helpers.character and helpers.movement then
            X.instantBayonetReady=true
            wrapMethod(musket,"ToggleBayonet",function(original,self,...)
                if not C.InstantBayonet then return original(self,...) end
                self.fireAction:CancelActions()
                self.weaponValue:SetAttribute("BayonetEnabled",self.bayonetEnabled)
                event:FireServer(not self.bayonetEnabled)
            end)
            wrapMethod(musket,"MoveEdge",function(original,self,edge,...)
                local timed=edge.edgeTimeActions
                if not C.InstantBayonet or not timed or timed.callbackName~="ToggleBayonet" then return original(self,edge,...) end
                if not self:GetEdgeEnabled(edge) then return end
                local now=os.clock()
                if self.vgBayonetPending and now-self.vgBayonetPending<.25 then return end
                self.vgBayonetPending=now
                if self.edgeTicket then self.edgeTicket[1]=false end
                local ticket={true};self.edgeTicket=ticket
                local pose=edge.pose;local previous=self.currentPose
                self.currentPose=pose
                if self.edgeTrack then self.edgeTrack:Stop(0);self.edgeTrack=nil end
                if self.stateTrack then self.stateTrack:Stop(0);self.stateTrack=nil end
                if pose~=previous then
                    local action=pose.fireAction and self.fireAction or pose.meleeAction and self.meleeAction or nil
                    if self.actionBound and self.actionBound~=action then self.actionBound:Unbind();self.actionBound=nil end
                    if action then action:Bind(edge.passToAction);self.actionBound=action end
                    helpers.character.setWalkSpeed(self.actionName,pose.walkSpeed)
                    if not previous or pose.combatCamera~=previous.combatCamera then helpers.movement.setCombatCameraLocked(pose.combatCamera or false) end
                    self:SetHints(pose.edges)
                end
                self:ToggleBayonet()
                if helpers.sounds and timed.soundName then helpers.sounds.playWeaponSound(timed.soundName) end
                if pose.stateAnimation then
                    local track=helpers.tracks.load(pose.stateAnimation)
                    if not ticket[1] then return end
                    track.Priority=Enum.AnimationPriority.Movement;track:Play(0);self.stateTrack=track
                end
            end)
        end
    end
end

