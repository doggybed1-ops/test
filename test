                beams[index]=make("Beam",{Attachment0=nodes[index],Attachment1=nodes[index+1],FaceCamera=true,Width0=.22,Width1=.22,LightEmission=.8,LightInfluence=0,
                    Color=ColorSequence.new(Color3.fromRGB(255,175,190),Color3.fromRGB(200,35,60)),
                    Transparency=NumberSequence.new(.15+.7*(index-1)/count),Enabled=false},anchor)
            end
            accumulated=1
        end
        horseFolder.Parent=workspace.CurrentCamera or workspace
        accumulated+=dt
        if accumulated>=1/30 then
            accumulated=0
            local ignore={horseFolder,horsePilot}
            if P.Character then table.insert(ignore,P.Character) end
            if workspace.CurrentCamera then table.insert(ignore,workspace.CurrentCamera) end
            local horses=workspace:FindFirstChild("Horses");if horses then table.insert(ignore,horses) end
            horseParams.FilterDescendantsInstances=ignore
            local fresh=X.horseGroundPath(horsePilot.CFrame,velocity,math.clamp(horsePilot.AssemblyAngularVelocity.Y,-3,3),math.clamp(C.CavPathSeconds,.5,3),count,function(position)
                local hit=workspace:Raycast(position+Vector3.new(0,32,0),Vector3.new(0,-96,0),horseParams)
                return hit and hit.Position+hit.Normal*.12 or nil
            end)
            for index=1,count+1 do
                if not targets[index] and fresh[index] then nodes[index].WorldPosition=fresh[index] end
                targets[index]=fresh[index]
            end
        end
        local alpha=1-math.exp(-20*math.min(dt,.1))
        for index=1,count+1 do if targets[index] then nodes[index].WorldPosition=nodes[index].WorldPosition:Lerp(targets[index],alpha) end end
        for index=1,count do beams[index].Enabled=targets[index]~=nil and targets[index+1]~=nil end
    end)
end

