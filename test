X.ui.dragHeader=make("TextButton",{Name="FullHeaderDrag",Text="",Position=UDim2.fromOffset(0,0),Size=UDim2.new(1,0,0,140),
    BackgroundTransparency=1,BorderSizePixel=0,AutoButtonColor=false,Active=true,ZIndex=2},panel)
-- The invisible hit region extends into headings without changing the visual layout.
function X.ui.canStartDrag(cursor)
    local header=X.ui.dragHeader
    local position,size=header.AbsolutePosition,header.AbsoluteSize
    if cursor.X<position.X or cursor.Y<position.Y or cursor.X>position.X+size.X or cursor.Y>position.Y+size.Y then return false end
    for _,object in ipairs(pg:GetGuiObjectsAtPosition(cursor.X,cursor.Y)) do
        if object~=header and object:IsDescendantOf(panel) then
            local ancestor=object
            while ancestor and ancestor~=panel do
                if ancestor~=header and (ancestor:IsA("GuiButton") or ancestor:IsA("TextBox") or ancestor:IsA("ScrollingFrame")) then
                    return false
                end
                ancestor=ancestor.Parent
            end
        end
    end
    return true
end

X.dragState={drag=false,origin=nil,base=nil,target=X.ui.mount.Position,touch=nil,settling=false}
do
    local state=X.dragState
    local function point(input)
        return Vector2.new(input.Position.X,input.Position.Y)
    end
    local function inside(object,cursor)
        local position,size=object.AbsolutePosition,object.AbsoluteSize
        return cursor.X>=position.X and cursor.Y>=position.Y
            and cursor.X<=position.X+size.X and cursor.Y<=position.Y+size.Y
    end
    local function stop(freeze)
        state.drag=false;state.touch=nil
        if state.savedMouseBehavior then
            UIS.MouseBehavior=state.savedMouseBehavior;state.savedMouseBehavior=nil
        end
        if freeze then state.target=X.ui.mount.Position;state.settling=false end
    end
    -- Global hit testing makes decorative labels and the logo safe drag targets.
    -- UI-processed clicks are intentionally accepted; the header still sinks them.
    X.ui.dragBeginConnection=connect(UIS.InputBegan,function(i)
        local mouse=i.UserInputType==Enum.UserInputType.MouseButton1
        local touch=i.UserInputType==Enum.UserInputType.Touch
        if not alive or not gui.Enabled or not panel.Visible or state.drag or not (mouse or touch) then return end
        local cursor=mouse and UIS:GetMouseLocation() or point(i)
        if not X.ui.canStartDrag(cursor) or inside(minimize,cursor) then return end
        X.ui.cancelSliders()
        state.drag=true;state.origin=cursor;state.point=cursor;state.base=X.ui.mount.Position;state.target=state.base
        state.touch=touch and i or nil;state.settling=true
        if mouse then
            state.savedMouseBehavior=UIS.MouseBehavior;UIS.MouseBehavior=Enum.MouseBehavior.Default
        end
    end)
    connect(UIS.InputChanged,function(i)
        if state.drag and state.touch and i==state.touch then state.point=point(i) end
        local slider=X.ui.activeSlider
        if slider and slider.dragging and ((slider.touch and i==slider.touch) or (not slider.touch and i.UserInputType==Enum.UserInputType.MouseMovement)) then
            if not X.ui.visible(slider.row) then slider.stop();return end
            slider.fromX(i.Position.X)
        end
    end)
    connect(UIS.InputEnded,function(i)
        if state.drag and ((state.touch and i==state.touch) or (not state.touch and i.UserInputType==Enum.UserInputType.MouseButton1)) then stop(false) end
        local slider=X.ui.activeSlider
        if slider and slider.dragging and ((slider.touch and i==slider.touch) or (not slider.touch and i.UserInputType==Enum.UserInputType.MouseButton1)) then slider.stop() end
    end)
    connect(UIS.WindowFocusReleased,function() stop(true);X.ui.cancelSliders() end)
    connect(panel:GetPropertyChangedSignal("Visible"),function()
        if not panel.Visible then stop(true);X.ui.cancelSliders() end
    end)
    X.ui.dragBinding="VGMenuDrag_"..P.UserId
    -- Run after the camera so its pointer lock cannot interrupt a held drag.
    Run:BindToRenderStep(X.ui.dragBinding,Enum.RenderPriority.Last.Value,function(dt)
        if not alive then return end
        if state.drag then
            if not state.touch and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then stop(false)
            else
                if not state.touch then
                    UIS.MouseBehavior=Enum.MouseBehavior.Default;state.point=UIS:GetMouseLocation()
                end
                local d=state.point-state.origin
                state.target=state.base+UDim2.fromOffset(d.X,d.Y);state.settling=true
            end
        end
        -- A stationary click or pause must never disable an active drag.
        if (state.drag or state.settling) and panel.Visible then
            local alpha=1-math.exp(-dt/X.ui.dragResponse)
            local current=X.ui.mount.Position
            if math.abs(current.X.Offset-state.target.X.Offset)+math.abs(current.Y.Offset-state.target.Y.Offset)<.05 then
                X.ui.mount.Position=state.target
                if not state.drag then state.settling=false end
            else X.ui.mount.Position=current:Lerp(state.target,alpha) end
        end
    end)
    table.insert(X.restores,function()
        Run:UnbindFromRenderStep(X.ui.dragBinding);stop(true);X.ui.cancelSliders()
    end)
    connect(gui.Destroying,function() stop(true);Run:UnbindFromRenderStep(X.ui.dragBinding) end)
    -- Slider motion remains presentation only; settings retain their exact values.
    connect(Run.RenderStepped,function(dt)
        if not alive then return end
        local alpha=1-math.exp(-dt/X.ui.sliderResponse)
        for _,slider in ipairs(X.ui.sliders) do
            if slider.dragging and not X.ui.visible(slider.row) then slider.stop() end
            if slider.current and slider.current~=slider.target then
                local value=slider.current+(slider.target-slider.current)*alpha
                if math.abs(value-slider.target)<.0001 then value=slider.target end
                slider.current=value
                slider.fill.Size=UDim2.new(value,0,1,0);slider.knob.Position=UDim2.new(value,0,.5,0)
            end
        end
    end)
end

VG_ADAPTER_EXPORTS.markStartup("menu text styling")
do
    -- Match legacy and dynamically created input fields to the shared surface style.
    local styled=setmetatable({},{__mode="k"})
    local function style(object)
        if styled[object] then return end
        styled[object]=true
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            if object.Font==Enum.Font.Code then object.Font=Enum.Font.BuilderSans end
            local function readable()
                if object.TextSize<X.ui.minTextSize then object.TextSize=X.ui.minTextSize end
                if object.TextScaled then object.TextScaled=false end
            end
            readable()
            connect(object:GetPropertyChangedSignal("TextSize"),readable)
            connect(object:GetPropertyChangedSignal("TextScaled"),readable)
            -- Informational paragraphs grow inside the existing scrolling columns.
            if object:IsA("TextLabel") and categoryHosts[object.Parent] then
                object.AutomaticSize=Enum.AutomaticSize.Y
            end
            if object:IsA("TextButton") and object.Parent and object.Parent:IsA("ScrollingFrame") then
                object.AutomaticSize=Enum.AutomaticSize.Y
            end
        end
        if object:IsA("TextBox") then
            object.BorderSizePixel=0;object.BackgroundColor3=Color3.fromRGB(15,18,25)
            object.PlaceholderColor3=Color3.fromRGB(132,104,114)
            if not object:FindFirstChildOfClass("UICorner") then make("UICorner",{CornerRadius=UDim.new(0,4)},object) end
        end
    end
    for _,object in ipairs(panel:GetDescendants()) do style(object) end
    connect(panel.DescendantAdded,style)
    X.mousePopup.Font=Enum.Font.BuilderSans;X.mousePopup.TextSize=14
    X.mousePopup.Size=UDim2.fromOffset(320,38);X.mousePopup.AutomaticSize=Enum.AutomaticSize.Y
end

