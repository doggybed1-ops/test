-- Read the native firearm spread at its source without changing shared game settings.
do
    X.noSpreadReady=false
    local state={enabled=false,patches={}}
    local function native(callback)
        local seen={}
        while VG_ADAPTER_EXPORTS.nativeOriginals[callback] do
            if seen[callback] then return nil end
            seen[callback]=true;callback=VG_ADAPTER_EXPORTS.nativeOriginals[callback]
        end
        return type(callback)=="function" and callback or nil
    end
    local function readValues(callback)
        local ok,values=pcall(debug.getupvalues,callback)
        return ok and type(values)=="table" and values or nil
    end
    local function readSpread(value)
        if type(value)~="table" then return nil end
        local ok,number=pcall(function() return value.ProjectileSpread end)
        if ok and type(number)=="number" and number==number and math.abs(number)<math.huge then return number end
    end
    local function restore()
        state.enabled=false;X.noSpreadReady=false
        for index=#state.patches,1,-1 do
            local entry=state.patches[index]
            local values=readValues(entry.callback)
            if values and values[entry.index]==entry.proxy then
                pcall(debug.setupvalue,entry.callback,entry.index,entry.previous)
                values=readValues(entry.callback)
            end
            if values and values[entry.index]~=entry.proxy then table.remove(state.patches,index) end
        end
        return #state.patches==0
    end
    local function resolveClass()
        local action=X.currentFireAction
        local class=type(action)=="table" and getmetatable(action) or nil
        if type(class)=="table" and rawget(class,"ClassName")=="FireActionClient" and type(class.Fire)=="function" then
            fireClass=class
        end
        if fireClass and type(fireClass.Fire)=="function" then return fireClass end
        if type(getloadedmodules)~="function" then return nil end
        local ok,modules=pcall(getloadedmodules)
        if not ok or type(modules)~="table" then return nil end
        -- The firearm module can arrive after the menu. Only already loaded exports are considered.
        for _,module in ipairs(modules) do
            if not alive then return nil end
            if not module:IsDescendantOf(game:GetService("CorePackages")) then
                local loaded,value=VGRequire(module)
                if loaded and type(value)=="table" and rawget(value,"ClassName")=="FireActionClient" and type(value.Fire)=="function" then
                    fireClass=value;return value
                end
            end
        end
    end
    local function discover(class)
        local queue,seen,candidates={},{},{}
        local function push(callback,depth)
            callback=native(callback)
            if callback and not seen[callback] then
                assert(#queue<128,"Firearm spread graph exceeds its safe discovery limit")
                seen[callback]=true;queue[#queue+1]={callback=callback,depth=depth}
            end
        end
        push(class.Fire,0);push(class.FireRelease,0)
        local inspected=0
        for position=1,128 do
            local frame=queue[position]
            if not frame then break end
            local values=readValues(frame.callback)
            if values then
                for index,value in pairs(values) do
                    inspected+=1
                    assert(inspected<=2048,"Firearm spread graph exceeds its safe discovery limit")
                    if type(index)=="number" and readSpread(value)~=nil then
                        candidates[#candidates+1]={callback=frame.callback,index=index,previous=value}
                    elseif type(value)=="function" and frame.depth<8 then
                        push(value,frame.depth+1)
                    end
                end
            end
        end
        return candidates
    end
    function X.setNoSpread(on)
        if not on then restore();return end
        assert(alive,"VG Client is unloaded")
        assert(debug and type(debug.getupvalues)=="function" and type(debug.setupvalue)=="function","Firearm upvalue access unavailable")
        assert(restore(),"Previous firearm spread adapter could not be restored")
        local class=resolveClass()
        assert(class,"Equip a firearm, then enable No spread again")
        local candidates=discover(class)
        assert(#candidates>0,"Native firearm spread settings are not available yet; equip a firearm and retry")
        local proxies,owned={},{ }
        local ok,reason=pcall(function()
            for _,entry in ipairs(candidates) do
                local values=readValues(entry.callback)
                local current=values and values[entry.index]
                -- Native closures can share the same upvalue cell. Do not stack proxies on that cell.
                if not owned[current] then
                    assert(current==entry.previous,"Native firearm spread owner changed; retry No spread")
                    local variables=entry.previous
                    local proxy=proxies[variables]
                    if not proxy then
                        proxy=setmetatable({}, {
                            __index=function(_,key)
                                if key=="ProjectileSpread" and state.enabled and alive and X.startup.ready and C.ZeroSpread then return 0 end
                                return variables[key]
                            end,
                            __newindex=function(_,key,value) variables[key]=value end,
                        })
                        if table.isfrozen(variables) then table.freeze(proxy) end
                        proxies[variables]=proxy;owned[proxy]=true
                    end
                    entry.proxy=proxy;state.patches[#state.patches+1]=entry
                    debug.setupvalue(entry.callback,entry.index,proxy)
                    values=readValues(entry.callback)
                    assert(values and values[entry.index]==proxy,"Native firearm spread adapter was not installed")
                end
            end
        end)
        if not ok then restore();error(tostring(reason),0) end
        state.enabled=true;X.noSpreadReady=true
    end
    table.insert(X.restores,restore)
end
-- Remove only the native aiming penalty. Other movement factors remain native.
do
    local variables=walkingVariables
    local function aimMultiplier(value)
        if type(value)~="table" then return nil end
        local ok,multiplier=pcall(function() return value.AimWalkSpeedMultiplier end)
        if ok and type(multiplier)=="number" and multiplier==multiplier and math.abs(multiplier)<math.huge then
            return multiplier
        end
        return nil
    end
    if fireClass and type(fireClass.BeginAiming)=="function" and not aimMultiplier(variables) then
        for _,value in pairs(VG_ADAPTER_EXPORTS.upvalues(fireClass.BeginAiming)) do
            if aimMultiplier(value) then variables=value;break end
        end
    end
    X.aimWalkSpeedReady=fireClass~=nil and type(fireClass.BeginAiming)=="function"
        and X.characterMovement~=nil and type(X.characterMovement.setWalkSpeed)=="function" and aimMultiplier(variables)~=nil
    local function currentAimingAction()
        local action=X.currentFireAction
        if action and action.actionBound and action.aiming and not action.reloading then return action end
        for other in pairs(X.fireActions or {}) do
            if other.actionBound and other.aiming and not other.reloading then
                X.currentFireAction=other
                return other
            end
        end
    end
    function X.setAimWalkSpeed(on)
        assert(X.aimWalkSpeedReady,"Aim movement adapter unavailable")
        local action=currentAimingAction()
        if action then
            local modifier=on and 1 or (action.aimWalkSpeedModifier or 1)*aimMultiplier(variables)
            X.characterMovement.setWalkSpeed("FireAction",modifier)
        end
    end
    if X.aimWalkSpeedReady then
        wrapMethod(fireClass,"BeginAiming",function(original,self,...)
            X.fireActions[self]=true
            X.currentFireAction=self
            local result=table.pack(original(self,...))
            if C.FullAimWalkSpeed and self.actionBound and self.aiming and not self.reloading then
                X.characterMovement.setWalkSpeed("FireAction",1)
            end
