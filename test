            if player~=P and (not C.TeamCheck or player.Team~=P.Team) then
                local model=X.states and X.states.getPlayerModel(player)
                local character=player.Character
                local head=character and character:FindFirstChild("Head")
                local h=character and character:FindFirstChildOfClass("Humanoid")
                if model and head and h and h.Health>0 and (head.Position-root.Position).Magnitude<=C.AimWarningRange then
                    local aiming=false
                    for _,track in ipairs(h:GetPlayingAnimationTracks()) do
                        local name=((track.Animation and track.Animation.Name or "").." "..track.Name):lower()
                        local animationId=track.Animation and track.Animation.AnimationId:match("%d+")
                        if (X.aimAnimationIds[animationId] or name:find("aim",1,true)) and track.WeightCurrent>.1 then aiming=true;break end
                    end
                    if aiming then
                        local muzzle,muzzleFrame
                        local equipped=model.equippedWeaponValue and model.equippedWeaponValue.Value
                        for _,weapon in pairs(model.characterWeapons or {}) do
                            if type(weapon)=="table" and weapon.model and (weapon.weaponValue==equipped or equipped and equipped.Name==weapon.weaponName) then
                                for _,object in ipairs(weapon.model:GetDescendants()) do
                                    if object:IsA("Attachment") and object.Name:lower():find("muzzle",1,true) then muzzle=object;break end
                                end
