local meleeFields=setmetatable({},{__mode="k"})
if meleeClass then
    wrapMethod(meleeClass,"ChargeAttack",function(original,self,...)
        if not meleeFields[self] then
            meleeFields[self]={chargeTime=self.chargeTime,fullChargeTime=self.fullChargeTime,attackTime=self.attackTime}
        end
        local base=meleeFields[self]
        local fast=cavalryAction(self) and C.CavFastSwing or (not cavalryAction(self) and C.FastMelee)
        self.chargeTime=fast and .01 or base.chargeTime
        self.fullChargeTime=fast and .01 or base.fullChargeTime
        self.attackTime=cavalryAction(self) and (C.CavFastSwing and .12 or base.attackTime) or (C.FastMeleeRecovery and C.MeleeRecovery or (C.FastMelee and .12 or base.attackTime))
        if fast then
            if not X.meleeChargeHelpers then
                local helpers={}
                for _,value in pairs(VG_ADAPTER_EXPORTS.upvalues(original)) do
                    if type(value)=="table" then
                        if type(rawget(value,"chargeAttack"))=="function" then helpers.combat=value end
                        if type(rawget(value,"load"))=="function" then helpers.tracks=value end
                        if type(rawget(value,"setChargingVignette"))=="function" then helpers.screen=value end
                    end
                end
                X.meleeChargeHelpers=helpers
            end
            local helpers=X.meleeChargeHelpers
            if helpers.combat and helpers.tracks then
                if self.currentTicket then self.currentTicket[1]=false end
                local ticket={true};self.currentTicket=ticket
                local direction=helpers.combat.chargeAttack(.01)
                local name=self.attackTrackNames[direction]
                local track=helpers.tracks.load(name)
                if track.WeightCurrent>0 then track=helpers.tracks.load(name,self.backupAttackTrackNames[direction]) end
                if not ticket[1] then return end
                track:Play(0,1,0);self.currentAttackTrack=track
                self.attackCharging=false;self.attackCharged=true;self.chargedFullDamage=true
                if self.chargingVignette and helpers.screen then helpers.screen.setChargingVignette(true) end
                if self.bracingEnabled then self:ConnectBracing() end
                self:EvaluateInput()
                return
            end
        end
        return original(self,...)
    end)
    wrapMethod(meleeClass,"GetDamage",function(original,self,...)
        if cavalryAction(self) and C.CavCritical then return 100 end
        if (cavalryAction(self) and C.CavDamage) or (not cavalryAction(self) and C.MaxMeleeDamage) then return 50 end
        return original(self,...)
    end)
end
