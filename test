-- Resolve the live game's crosshair on every use; never cache a pixel offset.
function X.resolveAimOrigin(camera,mouseBehavior,mouse,reticlePoint)
    if reticlePoint then return reticlePoint,"Reticle" end
    if camera and mouseBehavior==Enum.MouseBehavior.LockCenter then
        return camera.ViewportSize*.5,"Camera center"
    end
    return mouse,"Cursor"
end
-- Revalidate references every five seconds and immediately after camera/UI changes.
X.aimCalibration={nextCheck=0,checks=0}
function X.refreshAimCalibration(force)
    local state=X.aimCalibration
    local camera=workspace.CurrentCamera
    local root=pg:FindFirstChild("ReticleGui")
    local frame=root and root:FindFirstChild("ReticleFrame")
    local dot=frame and frame:FindFirstChild("ReticleDot")
    local inset=GuiService:GetGuiInset()
    local viewport=camera and camera.ViewportSize or Vector2.zero
    local now=os.clock()
    if force or now>=state.nextCheck or camera~=state.camera or root~=state.root
        or frame~=state.frame or dot~=state.dot or inset~=state.inset
        or viewport~=state.viewport or UIS.MouseBehavior~=state.mouseBehavior then
        state.camera=camera;state.root=root;state.frame=frame;state.dot=dot
        state.inset=inset;state.viewport=viewport;state.mouseBehavior=UIS.MouseBehavior
        state.nextCheck=now+5;state.checkedAt=now;state.checks+=1
    end
    return state
end
local function cursorViewport()
    local state=X.refreshAimCalibration(false)
    local camera,root,frame,dot=state.camera,state.root,state.frame,state.dot
    local reticle=dot and dot:IsA("GuiObject") and dot.Visible and dot or frame
    local point
    if camera and root and root:IsA("ScreenGui") and root.Enabled and reticle and reticle:IsA("GuiObject") then
        local visible=true
        local ancestor=reticle
        while ancestor and ancestor~=root do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then visible=false;break end
            if ancestor:IsA("CanvasGroup") and ancestor.GroupTransparency>=1 then visible=false;break end
            ancestor=ancestor.Parent
        end
        if visible and reticle.AbsoluteSize.X>0 and reticle.AbsoluteSize.Y>0 then
            -- AbsolutePosition is relative to CoreUISafeInsets; projection uses viewport pixels.
            local inset=state.inset
            local candidate=reticle.AbsolutePosition+reticle.AbsoluteSize*.5+inset
            if candidate.X>=0 and candidate.Y>=0 and candidate.X<=camera.ViewportSize.X and candidate.Y<=camera.ViewportSize.Y then
                point=candidate
            end
        end
    end
    local result,source=X.resolveAimOrigin(camera,UIS.MouseBehavior,UIS:GetMouseLocation(),point)
    X.aimOriginSource=source
    state.offset=result-UIS:GetMouseLocation()
    return result
end
