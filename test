                                end
                            end
                        end
                        if muzzleFrame then
                            local frame=muzzleFrame
                            local delta=root.Position-frame.Position
                            local along=delta:Dot(frame.LookVector)
                            local lateral=(delta-frame.LookVector*along).Magnitude
                            if along>0 and lateral<math.max(3,along*.025) then
                                local ignore={character,workspace.CurrentCamera}
                                if model.weaponsModel then table.insert(ignore,model.weaponsModel) end
                                params.FilterDescendantsInstances=ignore
                                local hit=workspace:Raycast(frame.Position,delta,params)
