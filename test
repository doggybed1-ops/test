            if motion then motion:Cancel() end
            if lastValue==nil then knob.Position=destination else
                motion=TweenService:Create(knob,TweenInfo.new(.14,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=destination})
                motion:Play()
            end
